# The console (admin Odoo): see install-control-plane.sh and docs/runbook/PREREQUISITES.md.
ADMIN_HOST=console.auditisa.com
HEARTBEAT_HOST=hb.auditisa.com
# `any`: the screens and port 22 open from anywhere (the owner's ruling of 2026-11-08), behind sign-in,
# two-factor, fail2ban and rate limits. Or a list of addresses, space separated, to restrict them.
OPERATOR_IPS=any
ADDONS_DIR=/opt/auditisa-platform/addons
# The firms' doors on HEARTBEAT_HOST: heartbeat only. Add `support` and/or `practice` when decided.
FIRM_DOORS=heartbeat
