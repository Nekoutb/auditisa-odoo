# recipe.env: every version a firm server is built from. Bump deliberately, and on all together:
# ODOO_SHA and PYTHON_VERSION are the same as .github/actions/setup-odoo/action.yml, and a test
# keeps them in step. Digests were taken on 2026-11-05 from the published files.
# shellcheck shell=bash disable=SC2034

UBUNTU_VERSION=26.04
POSTGRES_VERSION=18
ODOO_VERSION=19.0
ODOO_SHA=3cc89565f528accff539a295989891ffba6144fe
PYTHON_VERSION=3.12.16
UV_URL=https://github.com/astral-sh/uv/releases/download/0.13.7/uv-x86_64-unknown-linux-gnu.tar.gz
UV_SHA256=c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83
WKHTMLTOX_URL=https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.jammy_amd64.deb
WKHTMLTOX_SHA256=4f723b2691ad8638a9df960e0421d346d7315083e3583a334f33362280ddba15

APT_PACKAGES=(
  ufw fail2ban unattended-upgrades apt-listchanges iptables
  postgresql postgresql-client nginx certbot restic
  curl ca-certificates git openssl
  libpq-dev libxml2-dev libxslt1-dev libsasl2-dev libjpeg-dev zlib1g-dev libffi-dev libssl-dev
)
APT_OPTIONAL_PACKAGES=(
  libldap-dev libldap2-dev fonts-liberation xfonts-75dpi xfonts-base libxrender1 libxext6 libx11-6
  libjpeg-turbo8 libjpeg-turbo8t64
)
