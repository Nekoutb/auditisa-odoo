# The preview of the practice spaces on the staging computer (test.auditisa.com), beside staging's
# own Odoo. No wildcard name exists yet: one extra HTTPS port, and a link per space that chooses it.
PRACTICE_NAME='practice-preview'
PRACTICE_DOMAIN='practice.auditisa.com'
PRACTICE_PORT='8099'
PRACTICE_SERVICE='odoo-practice'
PRACTICE_CONF='/etc/odoo/practice.conf'
PRACTICE_DATA_DIR='/var/lib/odoo-practice'
PRACTICE_PUBLIC_URL='https://test.auditisa.com:8443'
PRACTICE_ENTRY_URL='https://test.auditisa.com:8443/practice/%s'
PRACTICE_PREVIEW='1'
PRACTICE_WORKERS='0'
PRACTICE_MEMORY='700M'
PRACTICE_UPDATE_MEM='1200M'
PRACTICE_LANG='fr_FR'
PRACTICE_HOLD_DAYS='7'
PRACTICE_HEARTBEAT_URL=''
PREVIEW_PORT='8443'
PREVIEW_HOST='test.auditisa.com'
PREVIEW_CERT='test.auditisa.com'
