<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_file_item_list_paper" model="ir.ui.view">
        <field name="name">ea.audit.file.item.list.paper</field>
        <field name="model">ea.audit.file.item</field>
        <field name="inherit_id" ref="ea_audit_core.view_file_item_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <button name="action_open_paper" type="object" string="Open paper" icon="fa-file-text-o"/>
            </xpath>
        </field>
    </record>
    <record id="view_file_item_form_paper" model="ir.ui.view">
        <field name="name">ea.audit.file.item.form.paper</field>
        <field name="model">ea.audit.file.item</field>
        <field name="inherit_id" ref="ea_audit_core.view_file_item_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_paper" type="object" string="Open paper" class="btn-primary"/>
            </xpath>
            <xpath expr="//field[@name='not_applicable']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
