<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Status page: environments on the left, the chosen one on the right, four tabs and People. -->
    <record id="view_environment_form" model="ir.ui.view">
        <field name="name">platform.environment.form</field>
        <field name="model">platform.environment</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0" duplicate="0" class="ea_env_form">
                <field name="code" invisible="1"/>
                <field name="can_connect" invisible="1"/>
                <field name="is_owner" invisible="1"/>
                <field name="is_operator" invisible="1"/>
                <sheet>
                    <div class="ea-env-layout">
                        <div class="ea-env-side">
                            <field name="sidebar_html" nolabel="1" readonly="1"/>
                        </div>
                        <div class="ea-env-main">
                            <div class="ea-env-head">
                                <div class="ea-env-title">
                                    <h1 class="mb-0"><field name="name" readonly="1"/></h1>
                                    <field name="head_html" nolabel="1" readonly="1"/>
                                </div>
                                <div class="ea-env-buttons">
                                    <button name="action_refresh" type="object" string="Read again" class="btn btn-link"
                                            help="Reads the latest figures and accounts the console has received."/>
                                    <button name="action_promote_staging" type="object" class="btn btn-primary"
                                            string="Promote to Staging"
                                            groups="ea_platform_admin.group_platform_owner"
                                            help="Sends the new version to the practice spaces on the staging server. You confirm once."/>
                                    <button name="action_promote_production" type="object" class="btn btn-outline-danger"
                                            string="Promote to Production"
                                            groups="ea_platform_admin.group_platform_owner"
                                            help="Sends the version Staging runs to the client firms. You confirm once."/>
                                    <button name="action_connect" type="object" class="btn btn-success" string="Connect"
                                            invisible="code == 'development' or not can_connect"
                                            help="Staging: opens it in a new tab. Practice: asks which space. Client firm: starts a read-only support visit."/>
                                </div>
                            </div>
                            <field name="release_html" nolabel="1" readonly="1"/>
                            <field name="info_html" nolabel="1" readonly="1"/>
                            <field name="rules_html" nolabel="1" readonly="1"/>
                            <notebook class="ea-env-tabs">
                                <page string="History" name="history">
                                    <field name="deploys_html" nolabel="1" readonly="1"/>
                                    <field name="commits_html" nolabel="1" readonly="1"/>
                                </page>
                                <page string="Backups" name="backups">
                                    <field name="backups_html" nolabel="1" readonly="1"/>
                                </page>
                                <page string="Monitor" name="monitor">
                                    <field name="monitor_html" nolabel="1" readonly="1"/>
                                    <group string="Pipeline reading (GitHub and the sites)" invisible="not stage_reading">
                                        <field name="stage_is_sample" invisible="1"/>
                                        <div colspan="2" class="alert alert-warning" role="status" invisible="not stage_is_sample">
                                            SAMPLE DATA: the collector is not connected yet. See PIPELINE.md, section 2.
                                        </div>
                                        <field name="branch"/>
                                        <field name="stage_github_commit" string="On GitHub" class="font-monospace"/>
                                        <field name="stage_running_commit" string="Running" class="font-monospace"/>
                                        <field name="stage_matches" string="Against GitHub"/>
                                        <field name="stage_where" string="Where it runs"/>
                                        <field name="stage_health" string="Health"/>
                                        <field name="stage_ahead" string="Lead on the next stage"/>
                                        <field name="stage_detail" string="Detail"/>
                                        <field name="stage_reading" string="Reading"/>
                                    </group>
                                </page>
                                <page string="Logs" name="logs">
                                    <field name="log_ids" nolabel="1" readonly="1">
                                        <list create="0" delete="0" limit="40">
                                            <field name="logged_at"/>
                                            <field name="user_id"/>
                                            <field name="firm_id" optional="show"/>
                                            <field name="action_text"/>
                                            <field name="detail_text"/>
                                        </list>
                                    </field>
                                </page>
                                <page string="People" name="people">
                                    <field name="people_html" nolabel="1" readonly="1"/>
                                    <div invisible="code not in ('staging', 'practice')">
                                        <div class="d-flex gap-2 mb-2">
                                            <button name="action_new_account" type="object" class="btn btn-primary" string="Create a test account..."
                                                    groups="ea_platform_admin.group_platform_operator"/>
                                        </div>
                                        <p class="text-muted" invisible="is_operator">You can look at this list. Only the owner and operators make or change accounts.</p>
                                        <field name="account_ids" nolabel="1" readonly="1">
                                            <list create="0" delete="0" decoration-muted="not active" limit="80">
                                                <field name="space" string="Practice space" column_invisible="parent.code != 'practice'"/>
                                                <field name="name"/>
                                                <field name="login"/>
                                                <field name="role"/>
                                                <field name="last_login"/>
                                                <field name="online" widget="boolean" width="110px"/>
                                                <field name="active" widget="boolean" width="80px"/>
                                                <field name="protected" column_invisible="1"/>
                                                <field name="pending" column_invisible="1"/>
                                                <button name="action_reset_password" type="object" string="New password..." icon="fa-key"
                                                        invisible="protected or pending" groups="ea_platform_admin.group_platform_operator"/>
                                                <button name="action_disable" type="object" string="Disable" icon="fa-ban"
                                                        invisible="protected or pending or not active" groups="ea_platform_admin.group_platform_operator"
                                                        confirm="Disable this account? The person can no longer sign in. Nothing they did is deleted."/>
                                            </list>
                                        </field>
                                        <h4 class="ea-env-section">Account requests</h4>
                                        <field name="request_ids" nolabel="1" readonly="1">
                                            <list create="0" delete="0" limit="15" decoration-danger="state == 'failed'" decoration-info="state == 'queued'">
                                                <field name="create_date" string="Asked on"/>
                                                <field name="action"/>
                                                <field name="target"/>
                                                <field name="login"/>
                                                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-info="state == 'queued'"/>
                                                <field name="message"/>
                                                <field name="requested_by_id"/>
                                            </list>
                                        </field>
                                    </div>
                                    <div invisible="code != 'production'">
                                        <field name="firm_ids" nolabel="1" readonly="1">
                                            <list create="0" delete="0">
                                                <field name="name"/>
                                                <field name="users_active" string="Accounts (count)" width="160px"/>
                                                <field name="last_heartbeat_at"/>
                                                <field name="health_color" widget="badge" decoration-success="health_color == 'green'"
                                                       decoration-warning="health_color == 'amber'" decoration-danger="health_color == 'red'"/>
                                            </list>
                                        </field>
                                    </div>
                                </page>
                            </notebook>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_environments" model="ir.actions.act_window">
        <field name="name">Status</field>
        <field name="res_model">platform.environment</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="environment_staging"/>
        <field name="path">status</field>
        <field name="view_id" ref="view_environment_form"/>
    </record>

    <!-- Connect -->
    <record id="view_environment_connect_form" model="ir.ui.view">
        <field name="name">platform.environment.connect.form</field>
        <field name="model">platform.environment.connect</field>
        <field name="arch" type="xml">
            <form>
                <field name="code" invisible="1"/>
                <div invisible="code != 'practice'">
                    <p>Choose the practice space to open. It opens in a new tab, on its own sign-in page.</p>
                    <group><field name="space" required="code == 'practice'"/></group>
                </div>
                <div invisible="code != 'production'">
                    <div class="alert alert-warning" role="status">
                        A client firm's data belongs to the firm. You do not sign in freely: the next screen starts a
                        <b>read-only support visit</b>. You give a reason and a length; the visit is logged, ends by itself,
                        and the firm sees it on its screen and can end it.
                    </div>
                    <group><field name="firm_id" required="code == 'production'" options="{'no_create': True, 'no_open': True}"/></group>
                </div>
                <footer>
                    <button name="action_open" type="object" string="Open in a new tab" class="btn-success" invisible="code != 'practice'"/>
                    <button name="action_open" type="object" string="Start a read-only support visit..." class="btn-primary" invisible="code != 'production'"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Test accounts -->
    <record id="view_environment_account_wizard_form" model="ir.ui.view">
        <field name="name">platform.environment.account.wizard.form</field>
        <field name="model">platform.environment.account.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="code" invisible="1"/>
                <field name="mode" invisible="1"/>
                <field name="done" invisible="1"/>
                <div invisible="done">
                    <p invisible="mode != 'create'">
                        A test account on <b invisible="code != 'staging'">Staging</b><b invisible="code != 'practice'">a practice space</b>.
                        The console makes a password and shows it to you once, on the next screen. Nothing is emailed:
                        give it to the person yourself.
                    </p>
                    <p invisible="mode != 'reset'">
                        A new password for this account. The old one stops working. The new one is shown to you once, on the next screen.
                    </p>
                    <group>
                        <field name="space" required="code == 'practice' and mode == 'create'" readonly="mode == 'reset'" invisible="code != 'practice'"/>
                        <field name="name" required="mode == 'create'" readonly="mode == 'reset'"/>
                        <field name="login" required="1" readonly="mode == 'reset'" placeholder="name@example.com"/>
                        <field name="role" required="mode == 'create'" invisible="mode != 'create'"/>
                    </group>
                </div>
                <div invisible="not done">
                    <div class="alert alert-success" role="status">
                        Sent. The account is ready within a minute; its line in the list shows when it is.
                    </div>
                    <group>
                        <field name="login_shown" readonly="1"/>
                        <field name="password" widget="CopyClipboardChar" readonly="1" class="ea-env-password"/>
                        <field name="request_ref" readonly="1"/>
                    </group>
                    <div class="alert alert-warning" role="status">
                        Copy the password now: it is shown <b>once</b>. The console does not keep it, and cannot show it again.
                    </div>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Create the account" class="btn-primary" invisible="done or mode != 'create'"/>
                    <button name="action_confirm" type="object" string="Make a new password" class="btn-primary" invisible="done or mode != 'reset'"/>
                    <button name="action_close" type="object" string="I have copied the password" class="btn-primary" invisible="not done"/>
                    <button special="cancel" string="Cancel" class="btn-secondary" invisible="done"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Promote to Staging, Promote to Production: what will happen, in plain words, and one Yes. -->
    <record id="view_environment_promote_form" model="ir.ui.view">
        <field name="name">platform.environment.promote.form</field>
        <field name="model">platform.environment.promote</field>
        <field name="arch" type="xml">
            <form>
                <field name="target" invisible="1"/>
                <div class="alert alert-warning" role="status" invisible="not problem">
                    <field name="problem" nolabel="1" readonly="1"/>
                </div>
                <field name="summary_html" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Yes, promote to Staging" class="btn-primary"
                            invisible="target != 'staging' or problem"/>
                    <button name="action_confirm" type="object" string="Yes, promote to Production" class="btn-danger"
                            invisible="target != 'production' or problem"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- The confirmation of a promotion shows exactly what will change. -->
    <record id="view_confirm_form_summary" model="ir.ui.view">
        <field name="name">platform.pipeline.confirm.form.summary</field>
        <field name="model">platform.pipeline.confirm</field>
        <field name="inherit_id" ref="view_confirm_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <field name="summary_html" nolabel="1" readonly="1" invisible="not summary_html"/>
            </xpath>
        </field>
    </record>

    <!-- A promotion: whether Staging runs it, and the result firm by firm. -->
    <record id="view_promotion_form_hold" model="ir.ui.view">
        <field name="name">platform.pipeline.promotion.form.hold</field>
        <field name="model">platform.pipeline.promotion</field>
        <field name="inherit_id" ref="view_promotion_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Staging first" invisible="not release_id or kind != 'promote'">
                    <field name="staging_ok" invisible="1"/>
                    <field name="staging_text" string="Staging"/>
                </group>
                <group string="Result, firm by firm" invisible="not rollout_id">
                    <field name="rollout_line_ids" nolabel="1" colspan="2" readonly="1">
                        <list create="0" delete="0">
                            <field name="firm_id"/>
                            <field name="batch"/>
                            <field name="state" widget="badge" decoration-success="state == 'healthy'" decoration-info="state == 'requested'"
                                   decoration-danger="state in ('failed', 'rolled_back', 'timed_out')"/>
                            <field name="requested_at"/>
                            <field name="closed_at"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
