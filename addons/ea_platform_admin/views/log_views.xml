<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_log_list" model="ir.ui.view">
        <field name="name">platform.log.list</field>
        <field name="model">platform.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="logged_at"/>
                <field name="user_id"/>
                <field name="firm_id"/>
                <field name="action"/>
                <field name="detail"/>
            </list>
        </field>
    </record>
    <record id="view_log_search" model="ir.ui.view">
        <field name="name">platform.log.search</field>
        <field name="model">platform.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="action"/>
                <field name="firm_id"/>
                <field name="user_id"/>
                <filter name="group_firm" string="Cabinet" context="{'group_by': 'firm_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_log" model="ir.actions.act_window">
        <field name="name">Journal</field>
        <field name="res_model">platform.log</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_breakglass_list" model="ir.ui.view">
        <field name="name">platform.breakglass.list</field>
        <field name="model">platform.breakglass</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="opened_at"/>
                <field name="firm_id"/>
                <field name="user_id"/>
                <field name="reason"/>
                <field name="firm_informed"/>
            </list>
        </field>
    </record>
    <record id="action_breakglass" model="ir.actions.act_window">
        <field name="name">Accès d'urgence</field>
        <field name="res_model">platform.breakglass</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
