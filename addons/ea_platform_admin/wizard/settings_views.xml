<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_settings_form" model="ir.ui.view">
        <field name="name">platform.settings.form</field>
        <field name="model">platform.settings</field>
        <field name="arch" type="xml">
            <form string="Platform settings" class="o_ea_platform_form" create="0" delete="0">
                <!-- A page, not a dialog: a footer would not show. -->
                <header>
                    <button name="action_save" type="object" string="Apply these settings" class="btn-primary"/>
                </header>
                <sheet>
                    <p class="text-muted">
                        No token or key is saved here. The Vultr token, the DNS token and the Wasabi key and secret
                        are in files only root can read, on this server: see PREREQUISITES.md and WASABI.md.
                    </p>
                    <group>
                        <group string="The provider">
                            <field name="provider" widget="radio"/>
                            <field name="confirm_real" invisible="provider != 'vultr'"/>
                            <field name="vultr_os_id"/>
                            <field name="dns_zone_id"/>
                        </group>
                        <group string="The addresses">
                            <field name="base_domain"/>
                            <field name="heartbeat_url"/>
                            <field name="ssh_allowlist" placeholder="your public IP address"/>
                        </group>
                    </group>
                    <group string="Backup storage and releases: Wasabi">
                        <field name="wasabi_region" placeholder="eu-central-1"/>
                        <field name="wasabi_endpoint" placeholder="s3.eu-central-1.wasabisys.com"/>
                        <field name="releases_bucket" placeholder="auditisa-releases-..."/>
                    </group>
                    <group string="Who may sign a new version">
                        <p class="text-muted" colspan="2">
                            Each person who signs new versions has their own key, kept on their own computer and locked
                            by their own passphrase. Only the public half is here. Firms accept a new version only if
                            one of these people signed it. Add or remove people in Platform &gt; Updates &gt; Signers.
                        </p>
                        <field name="signer_names" nolabel="1" colspan="2" readonly="1"/>
                        <button name="action_open_signers" type="object" string="Manage the signers" class="btn-secondary" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">platform.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
