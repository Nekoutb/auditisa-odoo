msgstr "Le bucket des versions s'appelle auditisa-releases- suivi d'au moins 8 lettres ou chiffres."

#. module: ea_platform_admin
#: model:ir.model.fields,field_description:ea_platform_admin.field_platform_settings__wasabi_region
msgid "Wasabi region"
msgstr "Région Wasabi"

#. module: ea_platform_admin
#: model:ir.model.fields,field_description:ea_platform_admin.field_platform_settings__wasabi_endpoint
msgid "Wasabi address (if not the region's own)"
msgstr "Adresse Wasabi (si ce n'est pas celle de la région)"

#. module: ea_platform_admin
#: model:ir.model.fields.selection,name:ea_platform_admin.selection__platform_settings__provider__vultr
