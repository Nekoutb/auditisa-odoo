<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_client_list" model="ir.ui.view">
        <field name="name">ea.audit.client.list</field>
        <field name="model">ea.audit.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="legal_form"/>
                <field name="sector" optional="show"/>
                <field name="registration_number" optional="show"/>
                <field name="niu" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_client_form" model="ir.ui.view">
        <field name="name">ea.audit.client.form</field>
        <field name="model">ea.audit.client</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="legal_form"/>
                            <field name="sector"/>
                            <field name="framework"/>
                            <field name="governance_mode"/>
                            <field name="regulator"/>
                        </group>
                        <group>
                            <field name="registration_number"/>
                            <field name="niu"/>
                            <field name="listed"/>
                            <field name="co_cac"/>
                            <field name="pie"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_client_search" model="ir.ui.view">
        <field name="name">ea.audit.client.search</field>
        <field name="model">ea.audit.client</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('registration_number', 'ilike', self), ('niu', 'ilike', self)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">ea.audit.client</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
