<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_team_member_list" model="ir.ui.view">
        <field name="name">ea.audit.team.member.list</field>
        <field name="model">ea.audit.team.member</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="invitation_engagement_name"/>
                <field name="invitation_client_name"/>
                <field name="invitation_fiscal_year" options="{'enable_formatting': false}"/>
                <field name="user_id"/>
                <field name="team_role"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_team_member_form" model="ir.ui.view">
        <field name="name">ea.audit.team.member.form</field>
        <field name="model">ea.audit.team.member</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_accept" type="object" string="Accept" class="btn-primary"
                            invisible="state != 'invited'"/>
                    <button name="%(action_team_decline_wizard)d" type="action" string="Decline"
                            context="{'default_member_id': id}" invisible="state != 'invited'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="invitation_engagement_name"/>
                            <field name="invitation_client_name"/>
                            <field name="invitation_fiscal_year" options="{'enable_formatting': false}"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="email"/>
                            <field name="team_role"/>
                            <field name="invited_at"/>
                            <field name="responded_at"/>
                            <field name="decline_reason" invisible="state != 'declined'"/>
                            <field name="eqr_declared_at" invisible="team_role != 'eqr_reviewer'"/>
                            <field name="eqr_declared_by_id" invisible="team_role != 'eqr_reviewer'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_my_invitations" model="ir.actions.act_window">
        <field name="name">My invitations</field>
        <field name="res_model">ea.audit.team.member</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid), ('state', '=', 'invited')]</field>
    </record>
</odoo>
