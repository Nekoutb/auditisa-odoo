<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_signoff_list" model="ir.ui.view">
        <field name="name">ea.audit.signoff.list</field>
        <field name="model">ea.audit.signoff</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="code"/>
                <field name="role"/>
                <field name="user_id"/>
                <field name="signed_at"/>
                <field name="voided_at" optional="hide"/>
                <field name="invalidated_at" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_signoff_form" model="ir.ui.view">
        <field name="name">ea.audit.signoff.form</field>
        <field name="model">ea.audit.signoff</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="engagement_id"/>
                            <field name="file_item_id"/>
                            <field name="kind"/>
                            <field name="role"/>
                            <field name="user_id"/>
                            <field name="signed_at"/>
                        </group>
                        <group>
                            <field name="version_no"/>
                            <field name="content_hash"/>
                            <field name="voided_at"/>
                            <field name="voided_by_id"/>
                            <field name="void_reason"/>
                            <field name="invalidated_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_signoff_policy_form" model="ir.ui.view">
        <field name="name">ea.audit.signoff.policy.form</field>
        <field name="model">ea.audit.signoff.policy</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <field name="min_reviewer_role"/>
                        <field name="require_distinct_preparer_approver"/>
                        <field name="allow_sole_practitioner" readonly="1"/>
                        <field name="allowed_email_domains"/>
                        <field name="firm_language"/>
                    </group>
                    <separator string="Partner sign-off required on"/>
                    <field name="require_partner_on_ids" nolabel="1" context="{'ea_task_with_title': True}" options="{'no_create': True}">
                        <list default_order="matrix_order">
                            <field name="code"/>
                            <field name="title"/>
                            <field name="phase"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_signoff_task_rule_list" model="ir.ui.view">
        <field name="name">ea.audit.signoff.task.rule.list</field>
        <field name="model">ea.audit.signoff.task.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="template_id" context="{'ea_task_with_title': True}" options="{'no_create': True}"/>
                <field name="min_preparer"/>
                <field name="min_reviewer"/>
                <field name="partner_required"/>
            </list>
        </field>
    </record>
    <record id="action_signoff_task_rule" model="ir.actions.act_window">
        <field name="name">Sign-off rules per task</field>
        <field name="res_model">ea.audit.signoff.task.rule</field>
        <field name="view_mode">list</field>
    </record>
    <!-- The default matrix, listed whole, with the firm's own rules applied (F002). -->
    <record id="view_signoff_matrix_list" model="ir.ui.view">
        <field name="name">ea.audit.task.template.signoff.matrix</field>
        <field name="model">ea.audit.task.template</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="matrix_order" decoration-info="matrix_firm_rule">
                <header>
                    <button name="action_matrix_export" type="object" string="Export to Excel" display="always" groups="ea_audit_core.group_partner"/>
                    <button name="action_matrix_import" type="object" string="Import from Excel" display="always" groups="ea_audit_core.group_partner"/>
                </header>
                <field name="code"/>
                <field name="title"/>
                <field name="phase"/>
                <field name="matrix_min_preparer"/>
                <field name="matrix_min_reviewer"/>
                <field name="matrix_partner"/>
                <field name="matrix_firm_rule"/>
            </list>
        </field>
    </record>
    <record id="action_signoff_matrix" model="ir.actions.act_window">
        <field name="name">Sign-off matrix</field>
        <field name="res_model">ea.audit.task.template</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_signoff_matrix_list"/>
    </record>
    <record id="view_signoff_matrix_import" model="ir.ui.view">
        <field name="name">ea.audit.signoff.matrix.import.form</field>
        <field name="model">ea.audit.signoff.matrix.import</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Export the matrix, fill in columns I, J and K, and import the file back. A blank cell applies the firm default. Nothing is saved if a row is wrong.</p>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_signoff_matrix_import" model="ir.actions.act_window">
        <field name="name">Import the sign-off matrix</field>
        <field name="res_model">ea.audit.signoff.matrix.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- The firm's audit log (F027): firm administrator only. -->
    <record id="view_activity_list" model="ir.ui.view">
        <field name="name">ea.audit.activity.list</field>
        <field name="model">ea.audit.activity</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="at" width="170px"/>
                <field name="user_id" width="130px"/>
                <field name="engagement_label" width="190px"/>
                <field name="code" optional="show" width="60px"/>
                <field name="summary_display"/>
                <field name="field_key" optional="hide"/>
                <field name="before" class="o_ea_clip" width="220px"/>
                <field name="after" class="o_ea_clip" width="220px"/>
            </list>
        </field>
    </record>
    <record id="view_activity_form" model="ir.ui.view">
        <field name="name">ea.audit.activity.form</field>
        <field name="model">ea.audit.activity</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="at"/>
                            <field name="user_id" options="{'no_open': true}"/>
                            <field name="engagement_label"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="field_key"/>
                        </group>
                    </group>
                    <group>
                        <field name="summary_display"/>
                        <field name="before"/>
                        <field name="after"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_activity_search" model="ir.ui.view">
        <field name="name">ea.audit.activity.search</field>
        <field name="model">ea.audit.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="summary"/>
                <field name="user_id"/>
                <field name="engagement_label"/>
                <field name="code"/>
                <field name="before"/>
                <field name="after"/>
                <filter name="answers" string="Answer changes" domain="[('field_key', '!=', False)]"/>
                <filter name="firm_level" string="Firm settings" domain="[('engagement_label', '=', False)]"/>
                <separator/>
                <filter name="filter_at" string="Date" date="at"/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="group_engagement" string="Engagement" context="{'group_by': 'engagement_label'}"/>
                <filter name="group_code" string="Task" context="{'group_by': 'code'}"/>
            </search>
        </field>
    </record>
    <record id="action_firm_audit_log" model="ir.actions.act_window">
        <field name="name">Audit log</field>
        <field name="res_model">ea.audit.activity</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_signoff_policy_open" model="ir.actions.server">
        <field name="name">Sign-off policy</field>
        <field name="model_id" ref="model_ea_audit_signoff_policy"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_firm_policy()</field>
    </record>
</odoo>
