<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_file_item_list" model="ir.ui.view">
        <field name="name">ea.audit.file.item.list</field>
        <field name="model">ea.audit.file.item</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="engagement_id" optional="show"/>
                <field name="code"/>
                <field name="title"/>
                <field name="state"/>
                <field name="preparer_id" optional="show"/>
                <field name="approver_id" optional="show"/>
                <field name="assignee_id" optional="show"/>
                <field name="due_date" optional="hide"/>
                <field name="not_applicable" optional="hide"/>
                <field name="conditional" optional="hide"/>
                <field name="conditional_trigger" optional="hide"/>
                <field name="merged_note" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_file_item_form" model="ir.ui.view">
        <field name="name">ea.audit.file.item.form</field>
        <field name="model">ea.audit.file.item</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_sign_preparer" type="object" string="Sign as preparer"/>
                    <button name="action_sign_reviewer" type="object" string="Sign as reviewer"/>
                    <button name="action_sign_partner" type="object" string="Sign as partner"/>
                    <button name="action_sign_eqr" type="object" string="Sign as EQR" invisible="code != 'C4.2'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not tool_outputs_missing">
                        <field name="tool_outputs_missing" readonly="1"/>
                    </div>
                    <div class="alert alert-info" role="status" invisible="not merged_note">
                        <field name="merged_note" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="engagement_id" readonly="1"/>
                            <field name="code"/>
                            <field name="title"/>
                            <field name="section"/>
                            <field name="task_phase"/>
                        </group>
                        <group>
                            <field name="team_user_ids" invisible="1"/>
                            <field name="preparer_id" options="{'no_create': true}" domain="[('id', 'in', team_user_ids), ('id', '!=', approver_id)]"/>
                            <field name="approver_id" options="{'no_create': true}" domain="[('id', 'in', team_user_ids), ('id', '!=', preparer_id), ('id', '!=', assignee_id)]"/>
                            <field name="assignee_id" options="{'no_create': true}" domain="[('id', 'in', team_user_ids), ('id', '!=', approver_id)]"/>
                            <field name="due_date"/>
                            <field name="not_applicable"/>
                            <field name="material" invisible="section != 'E'"/>
                            <field name="conditional" readonly="1"/>
                        </group>
                    </group>
                    <field name="signoff_ids" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <!-- In the order of the audit by default, acceptance to conclusion (owner, 2026-11-07). The
         Order and Phase columns sort in that order too; grouping by phase lists the phases so. -->
    <record id="view_task_template_list" model="ir.ui.view">
        <field name="name">ea.audit.task.template.list</field>
        <field name="model">ea.audit.task.template</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="matrix_order">
                <field name="chrono_no" width="70px"/>
                <field name="code"/>
                <field name="title"/>
                <field name="section"/>
                <field name="phase_step"/>
                <field name="tier"/>
                <field name="conditional"/>
            </list>
        </field>
    </record>
    <record id="view_task_template_search" model="ir.ui.view">
        <field name="name">ea.audit.task.template.search</field>
        <field name="model">ea.audit.task.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="title"/>
                <filter name="core" string="Core" domain="[('tier', '=', 'core')]"/>
                <filter name="conditional" string="Conditional" domain="[('conditional', '=', True)]"/>
                <group>
                    <filter name="group_phase" string="Phase" context="{'group_by': 'phase_step'}"/>
                    <filter name="group_section" string="Section" context="{'group_by': 'section'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_task_template_form" model="ir.ui.view">
        <field name="name">ea.audit.task.template.form</field>
        <field name="model">ea.audit.task.template</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="title"/>
                        <field name="short_title"/>
                        <field name="section"/>
                        <field name="phase"/>
                        <field name="tier"/>
                        <field name="conditional"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_task_template" model="ir.actions.act_window">
        <field name="name">Audit file index</field>
        <field name="res_model">ea.audit.task.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_task_template_list"/>
        <field name="search_view_id" ref="view_task_template_search"/>
    </record>
</odoo>
