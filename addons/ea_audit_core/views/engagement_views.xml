<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_engagement_list" model="ir.ui.view">
        <field name="name">ea.audit.engagement.list</field>
        <field name="model">ea.audit.engagement</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="client_id"/>
                <field name="display_name" string="Engagement"/>
                <field name="fiscal_year" options="{'enable_formatting': false}"/>
                <field name="period_end"/>
                <field name="phase"/>
                <field name="engagement_partner_id" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_engagement_form" model="ir.ui.view">
        <field name="name">ea.audit.engagement.form</field>
        <field name="model">ea.audit.engagement</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="advance_to_planning" type="object" string="Advance to planning"
                            class="btn-primary" invisible="phase != 'acceptance'"/>
                    <button name="close_planning" type="object" string="Close planning"
                            class="btn-primary" invisible="phase != 'planning'"/>
                    <button name="%(action_team_invite_wizard)d" type="action" string="Invite to the team"
                            context="{'default_engagement_id': id}"/>
                    <button name="%(action_partner_transfer_wizard)d" type="action" string="Transfer the partner role"
                            context="{'default_engagement_id': id}"/>
                    <button name="action_open_profile" type="object" string="Profile questionnaire"/>
                    <button name="action_rollforward_next_year" type="object" string="Roll forward"
                            confirm="Open next year's file for this client?"/>
                    <field name="phase" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="profile_pending" invisible="1"/>
                    <div class="alert alert-warning d-flex align-items-center gap-3" role="alert" invisible="not profile_pending">
                        <span class="flex-grow-1"><b>Profile not finished: finish it to get your tasks.</b></span>
                        <button name="action_open_profile" type="object" string="Finish the profile" class="btn-primary"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="client_id" readonly="1"/>
                            <field name="fiscal_year" readonly="1" options="{'enable_formatting': false}"/>
                            <field name="period_start" readonly="1" invisible="not period_start"/>
                            <field name="period_end" readonly="1"/>
                            <field name="duration_months" readonly="1"/>
                        </group>
                        <group>
                            <field name="nature_kind" readonly="1"/>
                            <field name="nature" string="Former nature" readonly="1"
                                   invisible="not nature or nature in ('statutory_audit', 'contractual_audit')"/>
                            <field name="complexity" readonly="1" invisible="not complexity"/>
                            <field name="profile_state" readonly="1"/>
                            <field name="framework"/>
                            <field name="report_language"/>
                            <field name="standards_edition" readonly="1"/>
                            <field name="engagement_partner_id" readonly="1"/>
                            <field name="partner_delegate_id"/>
                        </group>
                    </group>
                    <group name="dates" string="Report and file dates">
                        <group name="planned">
                            <field name="planned_report_date"/>
                            <field name="planned_agm_date"/>
                        </group>
                    </group>
                    <group string="Gates of this phase" invisible="not gate_summary">
                        <field name="gate_summary" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <notebook>
                        <page name="team" string="Team">
                            <field name="team_member_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="team_role"/>
                                    <field name="state" readonly="1"/>
                                    <field name="eqr_declaration" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page name="file_index" string="File index">
                            <field name="file_item_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_engagement_search" model="ir.ui.view">
        <field name="name">ea.audit.engagement.search</field>
        <field name="model">ea.audit.engagement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="client_id"/>
                <field name="fiscal_year"/>
                <field name="engagement_partner_id"/>
                <filter name="my_portfolio" string="My portfolio (as engagement partner)" domain="[('engagement_partner_id', '=', uid)]"/>
                <separator/>
                <filter name="group_phase" string="Phase" context="{'group_by': 'phase'}"/>
            </search>
        </field>
    </record>
    <record id="action_engagement" model="ir.actions.act_window">
        <field name="name">Engagements</field>
        <field name="res_model">ea.audit.engagement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
