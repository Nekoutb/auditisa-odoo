<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_firm_role" model="res.groups.privilege">
        <field name="name">AuditISA firm role</field>
        <field name="sequence">10</field>
    </record>

    <!-- Plumbing: what every firm role reads, and what every role but read_only writes. -->
    <record id="group_member" model="res.groups">
        <field name="name">Firm member</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_writer" model="res.groups">
        <field name="name">Firm writer</field>
        <field name="implied_ids" eval="[(4, ref('group_member'))]"/>
    </record>

    <!-- The firm roles of lib/rbac.ts. The client portal role belongs to a later addon. -->
    <record id="group_read_only" model="res.groups">
        <field name="name">Read only</field>
        <field name="privilege_id" ref="privilege_firm_role"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('group_member'))]"/>
    </record>
    <record id="group_eqr_reviewer" model="res.groups">
        <field name="name">EQR reviewer</field>
        <field name="privilege_id" ref="privilege_firm_role"/>
        <field name="sequence">15</field>
        <field name="implied_ids" eval="[(4, ref('group_writer'))]"/>
    </record>
    <record id="group_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="privilege_id" ref="privilege_firm_role"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_writer'))]"/>
    </record>
    <record id="group_senior" model="res.groups">
        <field name="name">Senior</field>
        <field name="privilege_id" ref="privilege_firm_role"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_staff'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_firm_role"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[(4, ref('group_senior'))]"/>
    </record>
    <record id="group_partner" model="res.groups">
        <field name="name">Partner</field>
        <field name="privilege_id" ref="privilege_firm_role"/>
        <field name="sequence">50</field>
        <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
    </record>
    <record id="group_firm_admin" model="res.groups">
        <field name="name">Firm administrator</field>
        <field name="privilege_id" ref="privilege_firm_role"/>
        <field name="sequence">60</field>
        <field name="implied_ids" eval="[(4, ref('group_partner'))]"/>
    </record>
</odoo>
