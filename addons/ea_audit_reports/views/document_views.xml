<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_list" model="ir.ui.view">
        <field name="name">ea.audit.document.list</field>
        <field name="model">ea.audit.document</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="code"/>
                <field name="title"/>
                <field name="kind" widget="badge"/>
                <field name="language"/>
                <field name="current_version" string="Version"/>
                <field name="write_date" string="Generated" widget="date"/>
                <button name="action_download" type="object" string="Word" icon="fa-file-word-o"/>
                <button name="action_print_pdf" type="object" string="PDF" icon="fa-file-pdf-o"/>
            </list>
        </field>
    </record>
    <record id="view_document_form" model="ir.ui.view">
        <field name="name">ea.audit.document.form</field>
        <field name="model">ea.audit.document</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_download" type="object" string="Download Word" class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF"/>
                </header>
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="code"/>
                        <field name="kind"/>
                        <field name="current_sha256"/>
                    </group>
                    <field name="version_ids" readonly="1">
                        <list>
                            <field name="version_no"/>
                            <field name="note"/>
                            <field name="byte_size"/>
                            <field name="sha256"/>
                            <field name="created_by_id"/>
                            <field name="create_date" string="Generated"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
