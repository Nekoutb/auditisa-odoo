    </record>
    <record id="rule_late_work_team_only" model="ir.rule">
        <field name="name">ea.audit.late.work: accepted team members only</field>
        <field name="model_id" ref="model_ea_audit_late_work"/>
        <field name="domain_force">[('engagement_id.team_member_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted')])]</field>
    </record>
</odoo>
