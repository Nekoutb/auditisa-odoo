        <field name="model_id" ref="model_ea_audit_completion_record"/>
        <field name="domain_force">[('engagement_id.team_member_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted')])]</field>
    </record>
    <record id="rule_legal_hold_team_only" model="ir.rule">
        <field name="name">ea.audit.legal.hold: accepted team members only</field>
        <field name="model_id" ref="model_ea_audit_legal_hold"/>
        <field name="domain_force">[('engagement_id.team_member_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted')])]</field>
    </record>
    <record id="rule_archive_manifest_team_only" model="ir.rule">
        <field name="name">ea.audit.archive.manifest: accepted team members only</field>
        <field name="model_id" ref="model_ea_audit_archive_manifest"/>
        <field name="domain_force">[('engagement_id.team_member_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted')])]</field>
    </record>
    <record id="rule_notice_own" model="ir.rule">
        <field name="name">ea.audit.notice: own rows only</field>
        <field name="model_id" ref="model_ea_audit_notice"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_archive_seal_team_only" model="ir.rule">
        <field name="name">ea.audit.archive.seal: accepted team members only</field>
        <field name="model_id" ref="model_ea_audit_archive_seal"/>
