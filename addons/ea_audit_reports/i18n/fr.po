msgstr "Aucun addendum."

#. module: ea_audit_reports
#. odoo-javascript
#: code:addons/ea_audit_reports/static/src/xml/archive_pages.xml:0
msgid "An addendum adds; it never changes or removes what was archived."
msgstr "Un addendum ajoute ; il ne modifie ni ne retire jamais ce qui a été archivé."

#. module: ea_audit_reports
#. odoo-javascript
#: code:addons/ea_audit_reports/static/src/xml/archive_pages.xml:0
msgid "Access log"
msgstr "Journal des accès"

