<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_document" model="ir.actions.report">
        <field name="name">Letter or report (PDF)</field>
        <field name="model">ea.audit.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ea_audit_reports.report_document</field>
        <field name="report_file">ea_audit_reports.report_document</field>
        <field name="print_report_name">object.title</field>
        <field name="binding_model_id" ref="model_ea_audit_document"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article" style="font-family: Calibri, Arial, sans-serif; font-size: 11pt;">
                    <img t-if="doc.env.company.sudo().logo" t-att-src="image_data_uri(doc.env.company.sudo().logo)" style="max-height: 60px;" alt="Logo"/>
                    <t t-foreach="doc._ea_print_blocks()" t-as="item">
                        <h1 t-if="item['t'] == 'title'" style="font-size: 18pt; margin: 18px 0;"><t t-esc="item['s']"/></h1>
                        <h2 t-elif="item['t'] == 'h'" style="font-size: 13pt; margin: 16px 0 6px;"><t t-esc="item['s']"/></h2>
                        <p t-elif="item['t'] == 'b'"><strong><t t-esc="item['s']"/></strong></p>
                        <p t-elif="item['t'] == 'i'"><em><t t-esc="item['s']"/></em></p>
                        <p t-elif="item['t'] == 'small'" style="font-size: 9pt; color: #5b6470;"><t t-esc="item['s']"/></p>
                        <p t-else=""><t t-esc="item['s']"/></p>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
