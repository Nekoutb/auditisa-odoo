<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ea_audit_timesheet.Sheet">
        <div class="ea-page ea-ts" t-if="data">
            <a class="ea-back" href="#" role="button" t-on-click.prevent="backToAudit">&#8592; <span>Back to the audit</span></a>
            <div class="ea-head ea-ts-head">
                <div>
                    <h1>Timesheet</h1>
                    <div class="ea-sub"><span t-esc="data.label"/></div>
                </div>
                <div class="ea-ts-nav">
                    <button type="button" class="ea-ts-ghost" aria-label="Previous week" title="Previous week" t-on-click="() => this.goWeek(data.prev)">&#8592;</button>
                    <button type="button" class="ea-ts-ghost" t-if="!data.is_current" t-on-click="() => this.goWeek(false)">This week</button>
                    <button type="button" class="ea-ts-ghost" aria-label="Next week" title="Next week" t-att-disabled="!data.has_next" t-on-click="() => this.goWeek(data.next)">&#8594;</button>
                    <button type="button" class="ea-ts-ghost" t-on-click="openReports">Reports</button>
                </div>
            </div>

            <div t-if="state.error" class="ea-ts-alert ea-ts-alert-rose" role="alert" t-esc="state.error"/>
            <div t-if="state.notice" class="ea-ts-alert ea-ts-alert-green" role="status" t-esc="state.notice"/>
            <div t-foreach="data.warnings" t-as="warning" t-key="warning.monday" class="ea-ts-alert ea-ts-alert-gold">
                <span t-esc="warning.text"/>
                <a href="#" role="button" class="ea-link" t-if="warning.monday !== data.monday" t-on-click.prevent="() => this.goWeek(warning.monday)">Open this week</a>
            </div>
            <div t-if="data.reopen" class="ea-ts-alert ea-ts-alert-gold" t-esc="reopenLine"/>

            <div class="ea-card ea-ts-entry" t-if="data.can_edit">
                <label><small>Date</small>
                    <select t-model="state.form.day">
                        <option t-foreach="selectableDays" t-as="day" t-key="day.date" t-att-value="day.date" t-esc="day.label"/>
                    </select>
                </label>
                <label class="ea-ts-grow"><small>Engagement or project</small>
                    <select t-model="state.form.project" t-on-change="onProject">
                        <option value="">Choose…</option>
                        <optgroup t-if="missions.length" label="My engagements">
                            <option t-foreach="missions" t-as="project" t-key="project.id" t-att-value="project.id" t-att-selected="isChosen(project)" t-esc="project.label"/>
                        </optgroup>
                        <optgroup t-if="internal.length" label="Internal projects">
                            <option t-foreach="internal" t-as="project" t-key="project.id" t-att-value="project.id" t-att-selected="isChosen(project)" t-esc="project.label"/>
                        </optgroup>
                    </select>
                </label>
                <label><small>Task (optional)</small>
                    <select t-model="state.form.task" t-att-disabled="!tasks.length">
                        <option value="">None</option>
                        <option t-foreach="tasks" t-as="task" t-key="task.id" t-att-value="task.id" t-esc="task.name"/>
                    </select>
                </label>
                <label class="ea-ts-hours"><small>Hours</small>
                    <input type="text" inputmode="decimal" t-model="state.form.hours"/>
                </label>
                <label class="ea-ts-note"><small>Note</small>
                    <input type="text" t-model="state.form.note"/>
                </label>
                <button type="button" class="ea-btn" t-on-click="charge">Charge</button>
            </div>

            <div class="ea-card ea-ts-week" t-att-class="{'ea-ts-locked': !data.can_edit}">
                <div class="ea-cardh">
                    <span><span t-att-class="statusClass" t-esc="data.status_label"/></span>
                    <span class="ea-muted" t-esc="deadlineLine"/>
                </div>
                <div class="ea-table-wrap">
                    <table class="ea-ts-grid">
                        <thead>
                            <tr>
                                <th class="ea-ts-first">Engagement or project</th>
                                <th t-foreach="data.days" t-as="day" t-key="day.date" t-att-class="{'ea-ts-today': day.today, 'ea-ts-we': day.weekend}" t-esc="day.label"/>
                                <th class="ea-ts-num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data.rows" t-as="row" t-key="row.key">
                                <td class="ea-ts-first">
                                    <b t-esc="row.label"/>
                                    <small t-if="row.task" t-esc="row.task"/>
                                </td>
                                <td t-foreach="data.days" t-as="day" t-key="day.date" t-att-class="{'ea-ts-today': day.today, 'ea-ts-we': day.weekend}">
                                    <input type="text" inputmode="decimal" class="ea-ts-cell" t-att-aria-label="day.label"
                                           t-att-value="row.cells[day.date] ? hours(row.cells[day.date]) : ''"
                                           t-att-disabled="!data.can_edit or day.future"
                                           t-on-change="(ev) => this.setCell(row, day, ev)"/>
                                </td>
                                <td class="ea-ts-num"><b t-esc="hours(row.total)"/></td>
                            </tr>
                            <tr t-if="!data.rows" class="ea-norow">
                                <td t-att-colspan="data.days.length + 2" class="ea-empty ea-ts-none">No hours this week.</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="ea-ts-first"><b>Total</b></td>
                                <td t-foreach="data.days" t-as="day" t-key="day.date" class="ea-ts-num" t-esc="data.totals[day.date] ? hours(data.totals[day.date]) : ''"/>
                                <td class="ea-ts-num"><b t-esc="hours(data.total)"/></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="ea-ts-foot">
                    <span class="ea-muted" t-if="data.submitted_at" t-esc="submittedLine"/>
                    <span class="ea-muted" t-if="data.status === 'locked'">This week was not submitted and is now read only. A firm administrator or partner can reopen it, with a written reason.</span>
                    <span class="ea-sp-grow"/>
                    <button type="button" class="ea-ts-ghost" t-if="data.can_recall" t-on-click="recall">Take back</button>
                    <button type="button" class="ea-btn" t-if="data.can_submit" t-on-click="submit">Submit the week</button>
                </div>
            </div>

            <div class="ea-card ea-ts-overdue" t-if="data.overdue.length">
                <div class="ea-cardh ea-ts-rose">Overdue, not submitted <span class="ea-count ea-ts-rose" t-esc="data.overdue.length"/></div>
                <a t-foreach="data.overdue" t-as="row" t-key="row.monday" class="ea-row" href="#" role="button" t-on-click.prevent="() => this.goWeek(row.monday)">
                    <span t-esc="overdueLine(row)"/>
                    <span class="ea-go">&#8594;</span>
                </a>
            </div>
        </div>
    </t>

    <t t-name="ea_audit_timesheet.Budget">
        <div class="ea-page ea-ts" t-if="state.data">
            <a class="ea-back" href="#" role="button" t-on-click.prevent="back">&#8592; <span>Back to the dashboard</span></a>
            <div class="ea-head ea-ts-head">
                <div>
                    <h1>Budget and actual</h1>
                    <div class="ea-sub" t-esc="state.data.engagement"/>
                </div>
                <div class="ea-big"><small>ACTUAL / BUDGET</small><b><t t-esc="hours(state.data.actual)"/> / <t t-esc="hours(state.data.budget)"/></b></div>
            </div>
            <div t-if="state.error" class="ea-ts-alert ea-ts-alert-rose" role="alert" t-esc="state.error"/>
            <div class="ea-card">
                <div class="ea-table-wrap">
                    <table class="ea-ts-grid ea-ts-budget">
                        <thead>
                            <tr>
                                <th class="ea-ts-first">Person</th>
                                <th t-foreach="state.data.phases" t-as="phase" t-key="phase.key" t-esc="phase.label"/>
                                <th class="ea-ts-num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.data.rows" t-as="row" t-key="row.member_id">
                                <td class="ea-ts-first"><b t-esc="row.name"/><small t-esc="row.team_role"/></td>
                                <td t-foreach="row.cells" t-as="cell" t-key="cell.phase">
                                    <span class="ea-ts-pair">
                                        <span t-att-class="{'ea-ts-rose': over(cell)}" t-esc="hours(cell.actual)"/>
                                        <span class="ea-muted">/</span>
                                        <input t-if="state.data.can_edit" type="text" inputmode="decimal" class="ea-ts-cell" aria-label="Budget"
                                               t-att-value="cell.budget ? hours(cell.budget) : ''" t-on-change="(ev) => this.setBudget(row, cell, ev)"/>
                                        <span t-else="" t-esc="hours(cell.budget)"/>
                                    </span>
                                </td>
                                <td class="ea-ts-num"><b t-esc="hours(row.actual)"/> / <t t-esc="hours(row.budget)"/></td>
                            </tr>
                        </tbody>
                        <tfoot t-if="state.data.lead">
                            <tr>
                                <td class="ea-ts-first"><b>Team</b></td>
                                <td t-foreach="state.data.totals" t-as="total" t-key="total.phase"><t t-esc="hours(total.actual)"/> / <t t-esc="hours(total.budget)"/></td>
                                <td class="ea-ts-num"><b t-esc="hours(state.data.actual)"/> / <t t-esc="hours(state.data.budget)"/></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <p class="ea-muted ea-ts-hint">Each cell reads actual hours / budget hours. An entry without a task counts in the phase the engagement is in on the day of entry.</p>
        </div>
    </t>

    <t t-name="ea_audit_timesheet.Reports">
        <div class="ea-page ea-ts" t-if="state.data">
            <div class="ea-head ea-ts-head">
                <div>
                    <h1>Time reports</h1>
                    <div class="ea-sub" t-esc="state.data.reach"/>
                </div>
                <div class="ea-ts-nav">
                    <button type="button" class="ea-ts-ghost" t-on-click="openPivot">Pivot table</button>
                    <a class="ea-btn" t-att-href="exportUrl">Excel export</a>
                </div>
            </div>
            <div t-if="state.error" class="ea-ts-alert ea-ts-alert-rose" role="alert" t-esc="state.error"/>
            <div t-if="state.notice" class="ea-ts-alert ea-ts-alert-green" role="status" t-esc="state.notice"/>
            <div class="ea-card ea-ts-entry">
                <label><small>From</small><input type="text" placeholder="DD/MM/YYYY" t-model="state.from"/></label>
                <label><small>To</small><input type="text" placeholder="DD/MM/YYYY" t-model="state.to"/></label>
                <button type="button" class="ea-btn" t-on-click="() => this.load()">Show</button>
                <span class="ea-sp-grow"/>
                <span class="ea-ts-tabs">
                    <button t-foreach="groupings" t-as="group" t-key="group.key" type="button" t-att-class="{on: state.data.group_by === group.key}" t-on-click="() => this.load(group.key)" t-esc="group.label"/>
                </span>
            </div>
            <div class="ea-card">
                <table class="ea-ts-grid ea-ts-report">
                    <thead><tr><th class="ea-ts-first" t-esc="groupHeader"/><th class="ea-ts-num">Hours</th></tr></thead>
                    <tbody>
                        <tr t-foreach="state.data.rows" t-as="row" t-key="row.label">
                            <td class="ea-ts-first" t-esc="row.label"/>
                            <td class="ea-ts-num" t-esc="hours(row.hours)"/>
                        </tr>
                        <tr t-if="!state.data.rows" class="ea-norow"><td colspan="2" class="ea-empty ea-ts-none">No hours in this period.</td></tr>
                    </tbody>
                    <tfoot><tr><td class="ea-ts-first"><b>Total</b></td><td class="ea-ts-num"><b t-esc="hours(state.data.total)"/></td></tr></tfoot>
                </table>
            </div>
            <div class="ea-card ea-ts-section" t-if="state.data.can_reopen">
                <div class="ea-cardh">Reopen a locked week</div>
                <div class="ea-ts-entry ea-ts-inset">
                    <label class="ea-ts-grow"><small>Person</small>
                        <select t-model="state.reopen.user">
                            <option value="">Choose…</option>
                            <option t-foreach="state.data.people" t-as="person" t-key="person.id" t-att-value="person.id" t-esc="person.name"/>
                        </select>
                    </label>
                    <label><small>A date of the week</small><input type="text" placeholder="DD/MM/YYYY" t-model="state.reopen.day"/></label>
                    <label class="ea-ts-grow"><small>Written reason</small><input type="text" t-model="state.reopen.reason"/></label>
                    <button type="button" class="ea-btn" t-on-click="reopen">Reopen for 48 hours</button>
                </div>
                <table class="ea-ts-grid ea-ts-report" t-if="state.data.journal.length">
                    <thead><tr><th class="ea-ts-first">Week</th><th>Person</th><th>Reason</th><th>By</th><th>Until</th><th>Status</th></tr></thead>
                    <tbody>
                        <tr t-foreach="state.data.journal" t-as="row" t-key="row.id">
                            <td class="ea-ts-first" t-esc="row.week"/><td t-esc="row.person"/><td t-esc="row.reason"/><td t-esc="row.by"/><td t-esc="row.until"/><td t-esc="row.state"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

    <t t-name="ea_audit_timesheet.Users">
        <div class="ea-page ea-ts" t-if="state.data">
            <div class="ea-head ea-ts-head">
                <div>
                    <h1>Users</h1>
                    <div class="ea-sub">The firm's people and their roles. A role gives no access to a file: only the engagement's team does.</div>
                </div>
            </div>
            <div t-if="state.error" class="ea-ts-alert ea-ts-alert-rose" role="alert" t-esc="state.error"/>
            <div t-if="state.notice" class="ea-ts-alert ea-ts-alert-green" role="status" t-esc="state.notice"/>
            <div class="ea-card ea-ts-entry">
                <label class="ea-ts-grow"><small>Email</small><input type="email" t-model="state.invite.email"/></label>
                <label class="ea-ts-grow"><small>Name</small><input type="text" t-model="state.invite.name"/></label>
                <label><small>Role</small>
                    <select t-model="state.invite.role">
                        <option t-foreach="state.data.roles" t-as="role" t-key="role.key" t-att-value="role.key" t-esc="role.label"/>
                    </select>
                </label>
                <label t-if="state.data.engagements.length"><small>Also add to engagement</small>
                    <select t-model="state.invite.engagement">
                        <option value="">No engagement</option>
                        <option t-foreach="state.data.engagements" t-as="eng" t-key="eng.id" t-att-value="eng.id" t-esc="eng.name"/>
                    </select>
                </label>
                <label t-if="state.invite.engagement"><small>Team role</small>
                    <select t-model="state.invite.teamRole">
                        <option t-foreach="state.data.team_roles" t-as="role" t-key="role.key" t-att-value="role.key" t-esc="role.label"/>
                    </select>
                </label>
                <button type="button" class="ea-btn" t-on-click="invite">Invite</button>
            </div>
            <div class="ea-ts-alert ea-ts-alert-green ea-ts-link" t-if="state.link">
                <div>
                    <b t-if="state.linkKind === 'password'">New password link</b>
                    <b t-else="">Invitation link</b>
                    <span class="ea-muted"> <t t-esc="state.linkFor"/></span>
                    <div class="ea-muted" t-if="state.linkKind === 'password'">Send it to this person yourself. They choose a new password: none is created or sent. The link works once and expires after 24 hours.</div>
                    <div class="ea-muted" t-else="">Send it to this person yourself. They choose their own password: none is created or sent. The link works once and expires after 72 hours.</div>
                    <code t-esc="state.link"/>
                </div>
                <button type="button" class="ea-ts-ghost" t-on-click="copyLink"><t t-if="state.copied">Copied</t><t t-else="">Copy</t></button>
            </div>
            <div class="ea-card">
                <table class="ea-ts-grid ea-ts-report">
                    <thead><tr><th class="ea-ts-first">Person</th><th>Role</th><th>Status</th><th>Last login</th><th/></tr></thead>
                    <tbody>
                        <tr t-foreach="state.data.users" t-as="row" t-key="row.id" t-att-class="{'ea-ts-off': !row.active}">
                            <td class="ea-ts-first"><b t-esc="row.name"/><small t-esc="row.login"/></td>
                            <td>
                                <span t-if="row.technical" class="ea-ts-pill ea-ts-technical">Technical support</span>
                                <span t-elif="row.is_me" t-esc="row.role_label"/>
                                <select t-else="" t-att-disabled="!row.active" t-on-change="(ev) => this.setRole(row, ev)">
                                    <option t-if="!row.role" value="" selected="selected">No role</option>
                                    <option t-foreach="state.data.roles" t-as="role" t-key="role.key" t-att-value="role.key" t-att-selected="role.key === row.role" t-esc="role.label"/>
                                </select>
                            </td>
                            <td t-esc="row.state_label"/>
                            <td t-esc="row.last_login"/>
                            <td class="ea-ts-acts">
                                <t t-if="!row.technical and !row.is_me">
                                    <button type="button" class="ea-ts-ghost" t-if="row.active and !row.joined" t-on-click="() => this.newLink(row)">New link</button>
                                    <button type="button" class="ea-ts-ghost" t-if="row.active and row.joined" t-on-click="() => this.passwordLink(row)">New password link</button>
                                    <button type="button" class="ea-ts-ghost" t-if="row.active" t-on-click="() => this.setActive(row, false)">Deactivate</button>
                                    <button type="button" class="ea-ts-ghost" t-else="" t-on-click="() => this.setActive(row, true)">Reactivate</button>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="ea-card ea-ts-section">
                <div class="ea-cardh">Allowed email domains</div>
                <div class="ea-ts-entry ea-ts-inset">
                    <label class="ea-ts-grow"><small>One per line. Empty means no restriction.</small><textarea rows="2" t-model="state.domains"/></label>
                    <button type="button" class="ea-btn" t-on-click="saveDomains">Save</button>
                </div>
            </div>
            <div class="ea-card ea-ts-section">
                <div class="ea-cardh">Administration log</div>
                <table class="ea-ts-grid ea-ts-report" t-if="state.data.log.length">
                    <thead><tr><th class="ea-ts-first">When</th><th>Event</th><th>By</th><th>About</th><th>Detail</th></tr></thead>
                    <tbody>
                        <tr t-foreach="state.data.log" t-as="row" t-key="row.id">
                            <td class="ea-ts-first" t-esc="row.at"/>
                            <td><span t-att-class="{'ea-ts-pill ea-ts-technical': row.support}" t-esc="row.kind"/></td>
                            <td t-esc="row.actor"/><td t-esc="row.target"/><td t-esc="row.detail"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

    <t t-name="ea_audit_timesheet.Settings">
        <div class="ea-page ea-ts" t-if="state.mail">
            <div class="ea-head ea-ts-head">
                <div>
                    <h1>Settings</h1>
                    <div class="ea-sub">The firm's internal projects.</div>
                </div>
            </div>
            <div t-if="state.error" class="ea-ts-alert ea-ts-alert-rose" role="alert" t-esc="state.error"/>
            <div t-if="state.notice" class="ea-ts-alert ea-ts-alert-green" role="status" t-esc="state.notice"/>
            <div class="ea-card ea-ts-section">
                <div class="ea-cardh">
                    <span>Outgoing mail</span>
                    <span><span class="ea-ts-pill" t-att-class="state.mail.on ? 'ea-ts-open' : 'ea-ts-locked_submitted'" t-esc="stateLabel"/></span>
                </div>
                <div class="ea-ts-entry ea-ts-inset ea-muted">AuditISA sets up the firm's outgoing mail when the firm is put into service. To change it, ask AuditISA.</div>
            </div>
            <div class="ea-card ea-ts-section">
                <div class="ea-cardh">Internal projects</div>
                <a t-foreach="state.projects" t-as="project" t-key="project.id" class="ea-row ea-ts-plain" t-att-class="{'ea-ts-off': !project.active}">
                    <span t-esc="project.name"/>
                    <button type="button" class="ea-ts-ghost" t-if="project.active" t-on-click="() => this.setProjectActive(project, false)">Archive</button>
                    <button type="button" class="ea-ts-ghost" t-else="" t-on-click="() => this.setProjectActive(project, true)">Reactivate</button>
                </a>
                <div class="ea-ts-entry ea-ts-inset">
                    <label class="ea-ts-grow"><small>New project</small><input type="text" t-model="state.newProject"/></label>
                    <button type="button" class="ea-btn" t-on-click="addProject">Add</button>
                </div>
            </div>
        </div>
    </t>
</templates>
