<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_significance_list" model="ir.ui.view">
        <field name="name">ea.audit.significance.list</field>
        <field name="model">ea.audit.significance</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" editable="bottom" decoration-danger="unjustified" class="o_ea_significance_list">
                <header>
                    <button name="action_list_export" type="object" string="Export to Excel" display="always"/>
                    <button name="action_list_import" type="object" string="Import from Excel" display="always" groups="ea_audit_core.group_writer"/>
                </header>
                <field name="unjustified" column_invisible="1"/>
                <field name="activity_dataset" column_invisible="1"/>
                <field name="preparer_known" column_invisible="1"/>
                <field name="reviewer_known" column_invisible="1"/>
                <field name="engagement_id" column_invisible="1"/>
                <field name="has_risk" column_invisible="1"/>
                <field name="index_code" readonly="1" width="160px"/>
                <field name="closing" readonly="1" width="105px"/>
                <!-- counted from the general ledger in use: empty when there is none, or the column was not matched -->
                <field name="tx_count" readonly="1" invisible="not activity_dataset" optional="show" width="95px"/>
                <field name="preparer_count" readonly="1" invisible="not preparer_known" optional="show" width="90px"/>
                <field name="reviewer_count" readonly="1" invisible="not reviewer_known" optional="show" width="85px"/>
                <field name="above_te" readonly="1" optional="show" width="80px"/>
                <!-- picked from this engagement's risk register; any live risk locks the row at Significant -->
                <field name="risk_ids" widget="many2many_tags" width="160px"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                       domain="[('engagement_id', '=', engagement_id), ('rebutted', '=', False)]"/>
                <field name="risk_assertions" readonly="1" optional="hide"/>
                <field name="default_status" readonly="1" optional="show" width="95px"/>
                <field name="status" widget="selection" decoration-success="status == 'significant'" decoration-bf="1" width="110px"
                       readonly="has_risk"/>
                <button name="action_change_status" type="object" string="Change status" icon="fa-exchange" class="btn-link"
                        title="Change between Significant and Not significant, with the reason" groups="ea_audit_core.group_writer"
                        invisible="has_risk"/>
                <button name="action_change_status" type="object" string="Locked by a risk" icon="fa-lock" class="btn-link text-muted opacity-50"
                        title="A linked risk keeps this account Significant: remove the link or rebut the risk in the risk register"
                        groups="ea_audit_core.group_writer" invisible="not has_risk"/>
                <field name="justification" placeholder="Required when the status departs from the default"/>
                <field name="assertion_ids" widget="many2many_tags" options="{'no_create': True}" width="95px"/>
                <field name="specific_te" width="95px"/>
            </list>
        </field>
    </record>

    <record id="view_significance_wizard" model="ir.ui.view">
        <field name="name">ea.audit.significance.wizard.form</field>
        <field name="model">ea.audit.significance.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="significance_id" invisible="1"/>
                <field name="needs_reason" invisible="1"/>
                <group>
                    <group>
                        <field name="index_code" readonly="1"/>
                        <field name="closing" readonly="1"/>
                    </group>
                    <group>
                        <field name="default_status" readonly="1"/>
                        <field name="current_status" readonly="1"/>
                    </group>
                </group>
                <group>
                    <field name="new_status" widget="radio" options="{'horizontal': true}"/>
                    <field name="reason" required="needs_reason" placeholder="Why this account is treated differently from the default"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not needs_reason">
                    This status departs from the default: the reason is required and is kept in the file's activity log.
                </div>
                <div class="alert alert-info" role="alert" invisible="needs_reason">
                    This is the default status: no reason is needed.
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
