<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_line_list" model="ir.ui.view">
        <field name="name">ea.audit.lead.line.list</field>
        <field name="model">ea.audit.lead.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" editable="bottom">
                <header>
                    <button name="action_list_export" type="object" string="Extract to Excel" display="always"/>
                </header>
                <field name="index_code" readonly="1"/>
                <field name="sub_index" readonly="1" optional="hide"/>
                <field name="account_code" readonly="1"/>
                <field name="account_name" readonly="1"/>
                <field name="closing" readonly="1" sum="Total"/>
                <field name="prior" readonly="1" sum="Total"/>
                <field name="movement" readonly="1" sum="Total"/>
                <field name="has_variance_pct" column_invisible="1"/>
                <field name="variance_pct" readonly="1" invisible="not has_variance_pct"/>
                <field name="commentary"/>
            </list>
        </field>
    </record>
    <record id="view_lead_line_search" model="ir.ui.view">
        <field name="name">ea.audit.lead.line.search</field>
        <field name="model">ea.audit.lead.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_code"/>
                <field name="account_name"/>
                <field name="index_code"/>
                <filter name="group_index" string="Lead index" context="{'group_by': 'index_code'}"/>
                <filter name="group_sub" string="Sub-index" context="{'group_by': 'sub_index'}"/>
            </search>
        </field>
    </record>
    <record id="view_lead_schedule_form" model="ir.ui.view">
        <field name="name">ea.audit.lead.schedule.form</field>
        <field name="model">ea.audit.lead.schedule</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="index_code" readonly="1"/>
                            <field name="paper_code" readonly="1"/>
                            <field name="account_class_label" readonly="1"/>
                            <field name="account_type_label" readonly="1"/>
                        </group>
                        <group>
                            <field name="closing" readonly="1"/>
                            <field name="prior" readonly="1"/>
                            <field name="movement" readonly="1"/>
                            <field name="variance_pct" readonly="1" invisible="not has_variance_pct"/>
                            <field name="has_variance_pct" invisible="1"/>
                        </group>
                    </group>
                    <field name="alerts" invisible="1"/>
                    <field name="alerts_label" readonly="1" invisible="not alerts" class="o_ea_banner"/>
                    <group><field name="commentary"/></group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="account_code"/>
                            <field name="account_name"/>
                            <field name="closing"/>
                            <field name="prior"/>
                            <field name="movement"/>
                            <field name="has_variance_pct" column_invisible="1"/>
                            <field name="variance_pct" invisible="not has_variance_pct"/>
                            <field name="commentary"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_engagement_lead_board" model="ir.ui.view">
        <field name="name">ea.audit.engagement.lead.board</field>
        <field name="model">ea.audit.engagement</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_export_lead" type="object" string="Extract to Excel" class="btn-primary"/>
                    <button name="action_tool_lead_lines" type="object" string="By account, with commentary"/>
                    <button name="action_tool_tb" type="object" string="Trial balance"/>
                </header>
                <sheet>
                    <div class="o_ea_title">Lead schedules</div>
                    <div class="o_ea_sub"><field name="display_name" readonly="1"/> · <field name="lead_prior_label" readonly="1"/></div>
                    <div class="o_ea_panel">
                        <field name="lead_schedule_ids" readonly="1" nolabel="1">
                            <list decoration-warning="alerts">
                                <field name="alerts" column_invisible="1"/>
                                <field name="index_code"/>
                                <field name="paper_code"/>
                                <field name="account_type_label" optional="show"/>
                                <field name="closing"/>
                                <field name="prior"/>
                                <field name="movement"/>
                                <field name="has_variance_pct" column_invisible="1"/>
                                <field name="variance_pct" invisible="not has_variance_pct"/>
                                <field name="commentary"/>
                            </list>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
