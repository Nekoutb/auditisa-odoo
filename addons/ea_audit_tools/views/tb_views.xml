<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tb_version_list" model="ir.ui.view">
        <field name="name">ea.audit.tb.version.list</field>
        <field name="model">ea.audit.tb.version</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" decoration-danger="validation_status == 'invalid'" decoration-muted="superseded_at and not is_current">
                <field name="create_date" string="Imported on" widget="datetime" options="{'show_seconds': false}" width="140px"/>
                <field name="timing" width="90px"/>
                <field name="validation_status" string="Status" widget="badge" decoration-success="validation_status == 'valid'" decoration-danger="validation_status == 'invalid'" width="80px"/>
                <field name="is_current" string="In use" width="65px"/>
                <field name="source_filename"/>
                <field name="row_count" width="60px"/>
                <field name="total_debit" string="Total debit" width="150px"/>
                <field name="total_credit" string="Total credit" width="150px"/>
                <field name="superseded_at" string="Superseded on" widget="datetime" options="{'show_seconds': false}" width="140px"/>
                <field name="create_uid" string="Imported by" width="110px"/>
                <button name="action_delete" type="object" icon="fa-trash-o" title="Delete this version" groups="ea_audit_core.group_writer"/>
            </list>
        </field>
    </record>
    <record id="view_tb_version_form" model="ir.ui.view">
        <field name="name">ea.audit.tb.version.form</field>
        <field name="model">ea.audit.tb.version</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Imported on"/>
                            <field name="create_uid" string="Imported by"/>
                            <field name="timing"/>
                            <field name="validation_status"/>
                            <field name="is_current"/>
                        </group>
                        <group>
                            <field name="source_filename"/>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                        </group>
                    </group>
                    <field name="checks_text" nolabel="1"/>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="account_code"/>
                            <field name="account_name"/>
                            <field name="opening_debit"/>
                            <field name="opening_credit"/>
                            <field name="debit"/>
                            <field name="credit"/>
                            <field name="closing"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_engagement_tb_board" model="ir.ui.view">
        <field name="name">ea.audit.engagement.tb.board</field>
        <field name="model">ea.audit.engagement</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_open_tb_import" type="object" string="Import a trial balance" class="btn-primary" groups="ea_audit_core.group_writer"/>
                    <button name="action_tool_lead" type="object" string="Lead schedules"/>
                    <button name="action_export_tb_template" type="object" string="Download the template"/>
                </header>
                <sheet>
                    <div class="o_ea_title">Trial balance</div>
                    <div class="o_ea_sub"><field name="display_name" readonly="1"/></div>
                    <div class="o_ea_banner" invisible="not tb_invalid_reason">
                        <b>The last import is invalid and does not drive the file:</b>
                        <field name="tb_invalid_reason" readonly="1" nolabel="1"/>
                    </div>
                    <div class="o_ea_banner" invisible="not tb_openings_warning"><field name="tb_openings_warning" readonly="1" nolabel="1"/></div>
                    <div class="o_ea_cards">
                        <div class="o_ea_card">
                            <div class="o_ea_card_label">Version in force</div>
                            <field name="tb_current_label" class="o_ea_card_value"/>
                            <div class="o_ea_card_note"><field name="tb_status_label"/></div>
                        </div>
                        <div class="o_ea_card">
                            <div class="o_ea_card_label">Total net assets</div>
                            <field name="bilan_total_assets" class="o_ea_card_value"/>
                            <div class="o_ea_card_note"><field name="bilan_label"/></div>
                        </div>
                        <div class="o_ea_card">
                            <div class="o_ea_card_label">Total equity and liabilities</div>
                            <field name="bilan_total_equity_liabilities" class="o_ea_card_value"/>
                            <div class="o_ea_card_note">Class 1 + current liabilities + result</div>
                        </div>
                    </div>
                    <div class="o_ea_panel">
                        <group string="Balance sheet (SYSCOHADA)">
                            <group string="Assets">
                                <field name="bilan_fixed_assets"/>
                                <field name="bilan_inventory"/>
                                <field name="bilan_receivables"/>
                                <field name="bilan_cash_assets"/>
                            </group>
                            <group string="Equity and liabilities">
                                <field name="bilan_class1"/>
                                <field name="bilan_class4_credit"/>
                                <field name="bilan_cash_liabilities"/>
                                <field name="bilan_net_result"/>
                            </group>
                        </group>
                    </div>
                    <div class="o_ea_panel">
                        <div class="o_ea_card_label">Versions</div>
                        <field name="tb_version_ids" readonly="1" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
