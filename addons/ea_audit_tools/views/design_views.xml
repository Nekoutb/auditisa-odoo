<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsp_design_list" model="ir.ui.view">
        <field name="name">ea.audit.dsp.design.list</field>
        <field name="model">ea.audit.dsp.design</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" editable="bottom" decoration-danger="significant">
                <header>
                    <button name="action_list_add_osp" type="object" string="Add another procedure" display="always" class="btn-primary" groups="ea_audit_core.group_writer"/>
                    <button name="action_list_export" type="object" string="Export to Excel" display="always"/>
                    <button name="action_list_import" type="object" string="Import from Excel" display="always" groups="ea_audit_core.group_writer"/>
                </header>
                <field name="index_code" readonly="1"/>
                <field name="assertion" readonly="1"/>
                <field name="tod_level"/>
                <field name="significant"/>
                <field name="not_rely" optional="show"/>
                <field name="nature"/>
                <field name="timing"/>
                <field name="extent"/>
                <field name="selected_count"/>
                <button name="action_open" type="object" string="Procedures"/>
            </list>
        </field>
    </record>
    <record id="view_dsp_design_form" model="ir.ui.view">
        <field name="name">ea.audit.dsp.design.form</field>
        <field name="model">ea.audit.dsp.design</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="index_code" readonly="1"/>
                            <field name="assertion" readonly="1"/>
                            <field name="tod_level"/>
                            <field name="significant"/>
                        </group>
                        <group>
                            <field name="nature"/>
                            <field name="timing"/>
                            <field name="extent"/>
                        </group>
                    </group>
                    <div class="o_ea_panel">
                        <div class="o_ea_card_label">Library procedures: what is ticked goes to the E4 paper</div>
                        <field name="choice_ids" nolabel="1">
                            <list create="0" delete="0" editable="bottom">
                                <field name="selected" widget="boolean_toggle"/>
                                <field name="label" readonly="1"/>
                                <field name="assertions_label"/>
                            </list>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_program_step_list" model="ir.ui.view">
        <field name="name">ea.audit.program.step.list</field>
        <field name="model">ea.audit.program.step</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <header>
                    <button name="action_list_generate_program" type="object" string="Generate a program" display="always" class="btn-primary" groups="ea_audit_core.group_writer"/>
                    <button name="action_list_add_step" type="object" string="Add a step" display="always" groups="ea_audit_core.group_writer"/>
                </header>
                <field name="file_item_id"/>
                <field name="seq"/>
                <field name="description"/>
                <field name="assertion_ids" widget="many2many_tags"/>
                <field name="source"/>
                <field name="status"/>
                <field name="conclusion" optional="show"/>
                <field name="completed_by_id" optional="hide"/>
                <field name="risk_ids" widget="many2many_tags" optional="hide"/>
                <button name="action_open_complete" type="object" string="Complete" invisible="status != 'open'" groups="ea_audit_core.group_writer"/>
                <button name="action_open_na" type="object" string="N/A" invisible="status != 'open'" groups="ea_audit_core.group_writer"/>
                <button name="action_uncomplete" type="object" string="Reopen" invisible="status != 'done'" groups="ea_audit_core.group_writer"/>
            </list>
        </field>
    </record>
    <record id="view_step_wizard" model="ir.ui.view">
        <field name="name">ea.audit.step.wizard.form</field>
        <field name="model">ea.audit.step.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="step_id" readonly="1"/>
                    <field name="mode" invisible="1"/>
                    <field name="text"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_program_step_search" model="ir.ui.view">
        <field name="name">ea.audit.program.step.search</field>
        <field name="model">ea.audit.program.step</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/>
                <field name="file_item_id"/>
                <filter name="group_task" string="Task" context="{'group_by': 'file_item_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_sap_list" model="ir.ui.view">
        <field name="name">ea.audit.sap.procedure.list</field>
        <field name="model">ea.audit.sap.procedure</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" decoration-danger="evaluation == 'above'">
                <field name="index_code"/>
                <field name="assertion"/>
                <field name="expectation_model"/>
                <field name="expected_value"/>
                <field name="actual_value"/>
                <field name="actual_source"/>
                <field name="threshold_amount"/>
                <field name="difference"/>
                <field name="evaluation"/>
                <field name="conclusion"/>
            </list>
        </field>
    </record>
    <record id="view_sap_threshold_wizard" model="ir.ui.view">
        <field name="name">ea.audit.sap.threshold.wizard.form</field>
        <field name="model">ea.audit.sap.threshold.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>The share of the expectation a difference may reach, by combined risk. Only procedures saved after this change take the new figures.</p>
                <group>
                    <field name="low"/>
                    <field name="moderate"/>
                    <field name="high"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sap_thresholds" model="ir.actions.act_window">
        <field name="name">Firm thresholds for substantive analytics</field>
        <field name="res_model">ea.audit.sap.threshold.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_sap_thresholds" name="Substantive analytics thresholds" parent="ea_audit_core.menu_settings"
              action="action_sap_thresholds" sequence="40" groups="ea_audit_core.group_firm_admin"/>
    <record id="view_engagement_sap_board" model="ir.ui.view">
        <field name="name">ea.audit.engagement.sap.board</field>
        <field name="model">ea.audit.engagement</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_open_sap_wizard" type="object" string="Save a procedure" class="btn-primary" groups="ea_audit_core.group_writer"/>
                    <button name="action_sap_procedures" type="object" string="The procedures"/>
                    <button name="action_export_sap" type="object" string="Export to Excel"/>
                    <button name="action_open_sap_thresholds" type="object" string="Firm thresholds" groups="ea_audit_core.group_firm_admin"/>
                </header>
                <sheet>
                    <div class="o_ea_title">Substantive analytics</div>
                    <div class="o_ea_sub">Expectation, threshold by risk, difference, conclusion (ISA 520).</div>
                    <div class="o_ea_cards">
                        <div class="o_ea_card">
                            <div class="o_ea_card_label">Firm thresholds: low, moderate, high</div>
                            <field name="sap_threshold_label" class="o_ea_card_value"/>
                            <div class="o_ea_card_note">Share of performance materiality. No CRA recorded reads as high.</div>
                        </div>
                    </div>
                    <div class="o_ea_panel">
                        <field name="sap_board_html" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_osp_wizard" model="ir.ui.view">
        <field name="name">ea.audit.osp.wizard.form</field>
        <field name="model">ea.audit.osp.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="engagement_id" invisible="1"/>
                <group>
                    <field name="index_code"/>
                    <field name="text"/>
                    <field name="assertion_ids" widget="many2many_tags"/>
                    <field name="nature"/>
                    <field name="timing"/>
                    <field name="extent"/>
                </group>
                <footer>
                    <button name="action_add" type="object" string="Add" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_program_wizard" model="ir.ui.view">
        <field name="name">ea.audit.program.wizard.form</field>
        <field name="model">ea.audit.program.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="engagement_id" invisible="1"/>
                <group>
                    <field name="mode"/>
                    <field name="file_item_id" options="{'no_create': True}"/>
                    <field name="description" invisible="mode != 'custom'" required="mode == 'custom'"/>
                    <field name="assertion_ids" widget="many2many_tags" invisible="mode != 'custom'"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_sap_wizard" model="ir.ui.view">
        <field name="name">ea.audit.sap.wizard.form</field>
        <field name="model">ea.audit.sap.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="engagement_id" invisible="1"/>
                <group>
                    <group>
                        <field name="index_code"/>
                        <field name="assertion"/>
                        <field name="expected_value"/>
                        <field name="actual_value"/>
                    </group>
                    <group>
                        <field name="use_override"/>
                        <field name="override_pct" invisible="not use_override"/>
                        <field name="override_reason" invisible="not use_override" required="use_override"/>
                        <field name="conclusion"/>
                    </group>
                </group>
                <group>
                    <field name="expectation_model"/>
                    <field name="inputs"/>
                    <field name="data_reliability"/>
                    <field name="investigation"/>
                    <field name="corroboration"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
