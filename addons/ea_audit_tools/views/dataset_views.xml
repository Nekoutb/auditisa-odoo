<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dataset_list" model="ir.ui.view">
        <field name="name">ea.audit.dataset.list</field>
        <field name="model">ea.audit.dataset</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" decoration-muted="superseded_at">
                <header>
                    <button name="action_list_import_dataset" type="object" string="Import a dataset" display="always" class="btn-primary" groups="ea_audit_core.group_writer"/>
                    <button name="action_list_template" type="object" string="Download the template" display="always"/>
                </header>
                <field name="create_date" string="Imported on" widget="datetime" options="{'show_seconds': false}" width="170px"/>
                <field name="kind" width="110px"/>
                <field name="timing" width="80px"/>
                <field name="is_current" width="65px"/>
                <field name="source_filename" width="200px"/>
                <field name="row_count" width="60px"/>
                <field name="display_total" width="130px"/>
                <field name="gl_line_count" optional="show" width="110px"/>
                <field name="validation_status" widget="badge" decoration-success="validation_status == 'passed'" decoration-warning="validation_status == 'warning'" decoration-danger="validation_status == 'failed'" optional="show" width="90px"/>
                <field name="superseded_at" string="Superseded on" widget="datetime" options="{'show_seconds': false}" width="170px"/>
                <field name="create_uid" string="Imported by" width="100px"/>
                <button name="action_delete" type="object" icon="fa-trash-o" title="Delete this upload" groups="ea_audit_core.group_writer"/>
            </list>
        </field>
    </record>
    <record id="view_gl_dataset_list" model="ir.ui.view">
        <field name="name">ea.audit.dataset.list.gl</field>
        <field name="model">ea.audit.dataset</field>
        <field name="inherit_id" ref="view_dataset_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_list_gl_catalogue" type="object" string="The thirty analytics" display="always"/>
            </xpath>
        </field>
    </record>
    <record id="view_engagement_gl_catalogue" model="ir.ui.view">
        <field name="name">ea.audit.engagement.gl.catalogue</field>
        <field name="model">ea.audit.engagement</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_tool_gl" type="object" string="The ledgers" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="o_ea_title">The thirty analytics of the ledger</div>
                    <div class="o_ea_sub">For reading: running one needs an imported ledger. Results are exceptions and risk indicators requiring audit consideration.</div>
                    <div class="o_ea_panel">
                        <field name="gl_catalogue_html" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_dataset_form" model="ir.ui.view">
        <field name="name">ea.audit.dataset.form</field>
        <field name="model">ea.audit.dataset</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_build_projection" type="object" string="Build the projection" class="btn-primary" invisible="kind != 'journal_entries' or gl_built_at or superseded_at" groups="ea_audit_core.group_writer"/>
                    <button name="action_open_console" type="object" string="Open the console" class="btn-primary" invisible="kind != 'journal_entries' or not gl_built_at"/>
                    <button name="action_open_lines" type="object" string="Ledger lines" invisible="not gl_built_at"/>
                    <button name="action_reconcile" type="object" string="Reconcile to the control account" class="btn-primary" invisible="not has_recon or superseded_at" groups="ea_audit_core.group_writer"/>
                    <button name="action_export_aging" type="object" string="Export the aging" invisible="kind not in ('ar_open_items', 'ap_open_items')"/>
                    <button name="action_open_supplier_recon" type="object" string="Supplier statements against the ledger" invisible="kind != 'supplier_statements' or superseded_at" groups="ea_audit_core.group_writer"/>
                    <button name="action_delete" type="object" string="Delete this upload" groups="ea_audit_core.group_writer"/>
                </header>
                <sheet>
                    <div class="o_ea_title"><field name="name" readonly="1"/></div>
                    <div class="o_ea_banner" invisible="not superseded_at">A later upload of this kind and timing has taken over: this one is kept as a record and is not in use. It is in use again if the later upload is deleted.</div>
                    <div class="o_ea_cards">
                        <div class="o_ea_card">
                            <div class="o_ea_card_label">Rows</div>
                            <field name="row_count" class="o_ea_card_value"/>
                            <div class="o_ea_card_note"><field name="source_filename"/></div>
                        </div>
                        <div class="o_ea_card" invisible="kind != 'journal_entries'">
                            <div class="o_ea_card_label">Projected lines</div>
                            <field name="gl_line_count" class="o_ea_card_value"/>
                            <div class="o_ea_card_note">Rejected lines: <field name="gl_rejected"/></div>
                        </div>
                        <div class="o_ea_card">
                            <div class="o_ea_card_label">Total amount</div>
                            <field name="display_total" class="o_ea_card_value"/>
                            <div class="o_ea_card_note"><field name="display_total_note"/></div>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="timing"/>
                        </group>
                        <group>
                            <field name="create_date" string="Imported on"/>
                            <field name="create_uid" string="Imported by"/>
                            <field name="superseded_at" invisible="not superseded_at"/>
                            <field name="gl_built_at" invisible="kind != 'journal_entries'"/>
                        </group>
                    </group>
                    <div class="o_ea_panel" invisible="not has_recon">
                        <div class="o_ea_card_label">Agreement to the trial balance</div>
                        <field name="has_recon" invisible="1"/>
                        <field name="recon_html" nolabel="1"/>
                    </div>
                    <div class="o_ea_panel" invisible="kind not in ('ar_open_items', 'ap_open_items')">
                        <div class="o_ea_card_label">Aging</div>
                        <field name="aging_html" nolabel="1"/>
                    </div>
                    <div class="o_ea_panel" invisible="not gl_built_at">
                        <div class="o_ea_card_label">Population checks</div>
                        <field name="validation_status" widget="badge" decoration-success="validation_status == 'passed'" decoration-warning="validation_status == 'warning'" decoration-danger="validation_status == 'failed'"/>
                        <field name="population_html" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gl_line_list" model="ir.ui.view">
        <field name="name">ea.audit.gl.line.list</field>
        <field name="model">ea.audit.gl.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="line_no"/>
                <field name="account"/>
                <field name="account_name" optional="show"/>
                <field name="je_number"/>
                <field name="journal_code" optional="show"/>
                <field name="journal_date"/>
                <field name="entry_date" optional="hide"/>
                <field name="je_description" optional="show"/>
                <field name="line_description" optional="hide"/>
                <field name="debit" sum="Debit"/>
                <field name="credit" sum="Credit"/>
                <field name="signed" sum="Signed" optional="hide"/>
                <field name="reference" optional="show"/>
                <field name="third_party_name" optional="hide"/>
                <field name="preparer" optional="hide"/>
                <field name="reviewer" optional="hide"/>
                <field name="approver" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_gl_line_pivot" model="ir.ui.view">
        <field name="name">ea.audit.gl.line.pivot</field>
        <field name="model">ea.audit.gl.line</field>
        <field name="arch" type="xml">
            <pivot disable_linking="1">
                <field name="account" type="row"/>
                <field name="journal_date" interval="month" type="col"/>
                <field name="signed" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_gl_line_search" model="ir.ui.view">
        <field name="name">ea.audit.gl.line.search</field>
        <field name="model">ea.audit.gl.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="account"/>
                <field name="je_number"/>
                <field name="journal_code"/>
                <field name="je_description"/>
                <field name="preparer"/>
                <field name="reviewer"/>
                <field name="approver"/>
                <filter name="missing_reference" string="Missing reference" domain="[('reference', '=', False)]"/>
                <separator/>
                <filter name="group_account" string="Account" context="{'group_by': 'account'}"/>
                <filter name="group_journal" string="Journal" context="{'group_by': 'journal_code'}"/>
                <filter name="group_entry" string="Entry" context="{'group_by': 'je_number'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'journal_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_supplier_recon_wizard" model="ir.ui.view">
        <field name="name">ea.audit.supplier.recon.wizard.form</field>
        <field name="model">ea.audit.supplier.recon.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="engagement_id" invisible="1"/>
                <group>
                    <field name="statement_id" options="{'no_create': True}"/>
                    <field name="ledger_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Run" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
