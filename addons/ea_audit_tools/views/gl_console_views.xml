<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- EAGLA, Elite Advisors Augmented General Ledger Analysis (owner's mock-ups of 18/11/2026):
         the general ledger console renamed, a left pane of groups and the chosen one on the right.
         "eagla-results-first" (18/11/2026): four lines that roll down and up on the left, an analysis
         runs as soon as it is picked, its result first, the ledger figures one small line under it. -->
    <record id="view_gl_console_form" model="ir.ui.view">
        <field name="name">ea.audit.gl.console.form</field>
        <field name="model">ea.audit.gl.console</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0" class="o_ea_eagla">
                <header>
                    <field name="validation_status" widget="badge" decoration-success="validation_status == 'passed'" decoration-warning="validation_status == 'warning'" decoration-danger="validation_status == 'failed'" invisible="not validation_status"/>
                </header>
                <sheet>
                    <field name="engagement_id" invisible="1"/>
                    <field name="gl_built_at" invisible="1"/>
                    <field name="figure_set" invisible="1"/>
                    <field name="pane" invisible="1"/>
                    <field name="scot_class" invisible="1"/>
                    <!-- the analysis picked in the left pane: kept out of sight, not invisible, so it stays writable -->
                    <div class="d-none"><field name="analytic_key"/></div>
                    <field name="analytic_listed" invisible="1"/>
                    <field name="analytic_ticked" invisible="1"/>
                    <div class="o_ea_eagla_mark">EAGLA™</div>
                    <div class="o_ea_title">EAGLA</div>
                    <div class="o_ea_sub">Elite Advisors Augmented General Ledger Analysis</div>
                    <div class="row">
                        <!-- Financial analysis, Analytical procedures, EAGLA analyses (1 to 32), SCOT identification
                             (Revenue, Purchases, Fixed assets, Treasury): action_eagla_financial,
                             action_eagla_analytical, the analysis picked (analytic_key) and action_scot. -->
                        <div class="col-lg-3 o_ea_eagla_nav">
                            <field name="eagla_nav" widget="ea_eagla_nav" nolabel="1"/>
                        </div>
                        <div class="col-lg-9">
                            <div class="o_ea_banner" invisible="dataset_id">No general ledger is in use on this file: upload one in the Data bank. Financial analysis and analytical procedures open without it.</div>
                            <div class="o_ea_panel" invisible="not figure_set">
                                <field name="figure_html" nolabel="1" readonly="1"/>
                                <button name="action_drill_figure" type="object" string="Lines behind the figure" class="btn-primary"/>
                            </div>

                            <!-- 31. Two-way correlation -->
                            <div invisible="not dataset_id or pane != 'analyses' or analytic_key != 'two-way-correlation'">
                                <div class="o_ea_card_label">31. Two-way correlation</div>
                                <group>
                                    <group>
                                        <field name="corr2_numerator" placeholder="443"/>
                                        <field name="corr2_denominator" placeholder="70"/>
                                    </group>
                                    <group>
                                        <field name="corr2_tolerance"/>
                                    </group>
                                </group>
                                <button name="action_run_two_way" type="object" string="Compute" class="btn-primary" invisible="not gl_built_at"/>
                                <field name="corr2_html" nolabel="1"/>
                            </div>

                            <!-- 32. Three-way correlation -->
                            <div invisible="not dataset_id or pane != 'analyses' or analytic_key != 'three-way-correlation'">
                                <div class="o_ea_card_label">32. Three-way correlation</div>
                                <group>
                                    <group>
                                        <field name="corr3_a" placeholder="70"/>
                                        <field name="corr3_b" placeholder="443"/>
                                        <field name="corr3_c" placeholder="411"/>
                                    </group>
                                </group>
                                <button name="action_run_three_way" type="object" string="Compute" class="btn-primary" invisible="not gl_built_at"/>
                                <field name="corr3_html" nolabel="1"/>
                            </div>

                            <!-- 1 to 30: the analytics of the catalogue, run as soon as one is picked -->
                            <div invisible="not dataset_id or pane != 'analyses' or not analytic_key or analytic_key in ('two-way-correlation', 'three-way-correlation')">
                                <div class="o_ea_eagla_h"><field name="analytic_title" nolabel="1"/></div>
                                <group invisible="analytic_key not in ('year-end-concentration', 'monthly-spikes', 'top-value', 'round-numbers', 'repeated-amounts', 'rare-accounts', 'third-party-attribution', 'preparer-volume', 'preparer-value', 'reviewer-workload')">
                                    <group>
                                        <field name="year_end_days" invisible="analytic_key != 'year-end-concentration'"/>
                                        <field name="sd_factor" invisible="analytic_key != 'monthly-spikes'"/>
                                        <field name="percentile" invisible="analytic_key != 'top-value'"/>
                                        <field name="round_min" widget="ea_amount" invisible="analytic_key != 'round-numbers'"/>
                                        <field name="round_step" widget="ea_amount" invisible="analytic_key != 'round-numbers'"/>
                                        <field name="min_occurrences" invisible="analytic_key != 'repeated-amounts'"/>
                                        <field name="rare_max" invisible="analytic_key != 'rare-accounts'"/>
                                        <field name="prefixes" invisible="analytic_key != 'third-party-attribution'"/>
                                        <field name="top_n" invisible="analytic_key not in ('preparer-volume', 'preparer-value', 'reviewer-workload')"/>
                                    </group>
                                </group>
                                <field name="analytic_items" widget="ea_eagla_items" nolabel="1" invisible="not analytic_listed"/>
                                <button name="action_export_analytic" type="object" string="Extract all to Excel" invisible="analytic_listed"/>
                                <field name="analytic_html" nolabel="1"/>
                                <p class="o_ea_legend">Amounts in FCFA, signed: debits positive, credits negative. Results are exceptions and risk indicators requiring audit consideration.</p>
                            </div>

                            <!-- SCOT identification -->
                            <div invisible="not dataset_id or pane != 'scot'">
                                <div class="o_ea_card_label">SCOT identification</div>
                                <p class="o_ea_legend">The significant classes of transactions (SCOT), read from the general ledger of the year on SYSCOHADA account prefixes.</p>
                                <div class="o_ea_title fs-5" invisible="scot_class != 'revenue'">Revenue</div>
                                <div class="o_ea_title fs-5" invisible="scot_class != 'purchases'">Purchases</div>
                                <div class="o_ea_title fs-5" invisible="scot_class != 'fixed_assets'">Fixed assets</div>
                                <div class="o_ea_title fs-5" invisible="scot_class != 'treasury'">Treasury</div>
                                <field name="scot_html" nolabel="1"/>
                                <field name="scot_pattern_ids" nolabel="1" readonly="1" invisible="not scot_pattern_ids">
                                    <list create="0" delete="0" decoration-danger="unusual">
                                        <field name="debit_group"/>
                                        <field name="credit_group"/>
                                        <field name="journal"/>
                                        <field name="entries"/>
                                        <field name="amount" widget="ea_amount"/>
                                        <field name="unusual" widget="boolean"/>
                                        <button name="action_open_entries" type="object" string="Entries" icon="fa-list"/>
                                    </list>
                                </field>
                            </div>

                            <!-- The ledger: its figures in one small line, under the results -->
                            <field name="head_html" nolabel="1" readonly="1" invisible="not dataset_id"/>
                            <group class="o_ea_eagla_ledger">
                                <group>
                                    <field name="dataset_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="gl_line_count" invisible="not dataset_id"/>
                                </group>
                            </group>

                            <!-- Below the result, two panels that roll down and up, closed at first -->
                            <div invisible="not dataset_id or pane != 'analyses' or not analytic_key or analytic_key in ('two-way-correlation', 'three-way-correlation')">
                                <details class="o_ea_eagla_fold">
                                    <summary>Lines behind a month</summary>
                                    <group>
                                        <group>
                                            <field name="drill_month"/>
                                        </group>
                                    </group>
                                    <button name="action_drill_month" type="object" string="Open the lines"/>
                                </details>
                                <details class="o_ea_eagla_fold">
                                    <summary>The thirty analytics, against this ledger</summary>
                                    <field name="catalogue_html" nolabel="1" readonly="1"/>
                                </details>
                            </div>

                            <!-- The console's other tabs, kept as they were -->
                            <notebook invisible="not dataset_id or pane != 'analyses'">
                                <page string="Entry analysis" name="entry">
                                    <group>
                                        <group>
                                            <field name="selected_accounts"/>
                                        </group>
                                    </group>
                                    <div class="o_ea_panel">
                                        <div class="o_ea_card_label">Pick accounts</div>
                                        <group>
                                            <group>
                                                <field name="account_search"/>
                                            </group>
                                            <group>
                                                <field name="picker_note" nolabel="1" colspan="2"/>
                                            </group>
                                        </group>
                                        <button name="action_search_accounts" type="object" string="Find" class="me-2"/>
                                        <button name="action_add_picked" type="object" string="Add the ticked accounts" invisible="not account_ids"/>
                                        <field name="account_ids" nolabel="1" invisible="not account_ids">
                                            <list editable="bottom" create="0" delete="0">
                                                <field name="selected" widget="boolean_toggle"/>
                                                <field name="account"/>
                                                <field name="name"/>
                                                <field name="lines"/>
                                                <field name="entries"/>
                                                <field name="debit" widget="ea_amount"/>
                                                <field name="credit" widget="ea_amount"/>
                                                <field name="signed" widget="ea_amount"/>
                                            </list>
                                        </field>
                                    </div>
                                    <group>
                                        <group>
                                            <field name="entry_mode" widget="radio" options="{'horizontal': true}"/>
                                            <field name="entry_period" widget="radio" options="{'horizontal': true}"/>
                                        </group>
                                        <group>
                                            <field name="entry_rank"/>
                                            <field name="entry_limit"/>
                                        </group>
                                    </group>
                                    <button name="action_run_entry" type="object" string="Analyse the entries" class="btn-primary"/>
                                    <field name="entry_html" nolabel="1"/>
                                    <div class="o_ea_panel">
                                        <div class="o_ea_card_label">Lines behind a cell</div>
                                        <group>
                                            <group>
                                                <field name="drill_account" string="Counterpart account"/>
                                                <field name="drill_month" invisible="entry_period != 'month'"/>
                                                <field name="drill_weekday" invisible="entry_period != 'weekday'"/>
                                            </group>
                                        </group>
                                        <button name="action_drill_entry" type="object" string="Open the lines"/>
                                    </div>
                                    <div class="o_ea_panel">
                                        <div class="o_ea_card_label">Filter lines: every condition must hold</div>
                                        <group>
                                            <group>
                                                <field name="filter_accounts"/>
                                                <field name="filter_date_from"/>
                                                <field name="filter_date_to"/>
                                                <field name="filter_min_abs"/>
                                                <field name="filter_max_abs"/>
                                                <field name="filter_journal"/>
                                            </group>
                                            <group>
                                                <field name="filter_je"/>
                                                <field name="filter_preparer"/>
                                                <field name="filter_reviewer"/>
                                                <field name="filter_approver"/>
                                                <field name="filter_weekend"/>
                                                <field name="filter_missing_reference"/>
                                            </group>
                                        </group>
                                        <button name="action_drill_filter" type="object" string="Open the lines"/>
                                    </div>
                                </page>
                                <page string="Two accounts" name="correlation">
                                    <group>
                                        <group>
                                            <field name="corr_a" placeholder="First selected account"/>
                                            <field name="corr_b" placeholder="Second selected account"/>
                                        </group>
                                    </group>
                                    <button name="action_run_correlation" type="object" string="Correlate" class="btn-primary me-2"/>
                                    <button name="action_swap" type="object" string="Swap"/>
                                    <p class="o_ea_legend">Restricted to the entries containing both accounts. The ratio is account A over account B, its sign kept.</p>
                                    <field name="corr_html" nolabel="1"/>
                                    <div class="o_ea_panel">
                                        <div class="o_ea_card_label">Lines behind a cell</div>
                                        <group>
                                            <group>
                                                <field name="drill_account" string="Account"/>
                                                <field name="drill_month"/>
                                            </group>
                                        </group>
                                        <button name="action_drill_correlation" type="object" string="Open the lines"/>
                                    </div>
                                </page>
                                <page string="Insights" name="insights">
                                    <button name="action_load_insights" type="object" string="Compute the insights" class="btn-primary"/>
                                    <field name="insights_html" nolabel="1"/>
                                    <div class="o_ea_panel">
                                        <div class="o_ea_card_label">Correlation between account prefixes</div>
                                        <group>
                                            <group>
                                                <field name="prefix_accounts"/>
                                            </group>
                                        </group>
                                        <button name="action_run_matrix" type="object" string="Compare"/>
                                        <field name="matrix_html" nolabel="1"/>
                                    </div>
                                </page>
                            </notebook>

                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
