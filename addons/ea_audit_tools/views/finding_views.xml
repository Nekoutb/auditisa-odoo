<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finding_list" model="ir.ui.view">
        <field name="name">ea.audit.finding.list</field>
        <field name="model">ea.audit.finding</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="reference"/>
                <field name="title"/>
                <field name="file_item_id" string="Paper"/>
                <field name="route"/>
                <field name="severity" widget="badge" decoration-warning="severity == 'significant_deficiency'"/>
                <field name="amount"/>
                <field name="state_label"/>
                <field name="communicated_on" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_finding_form" model="ir.ui.view">
        <field name="name">ea.audit.finding.form</field>
        <field name="model">ea.audit.finding</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_open_evaluation" type="object" string="ISA 265 evaluation" invisible="route != 'c1'" class="btn-primary" groups="ea_audit_core.group_writer"/>
                    <button name="action_open_clear" type="object" string="Clear" invisible="status != 'open' or route == 'b5'" groups="ea_audit_core.group_writer"/>
                </header>
                <sheet>
                    <group>
                        <field name="reference"/>
                        <field name="title"/>
                    </group>
                    <group>
                        <group>
                            <field name="route"/>
                            <field name="severity"/>
                            <field name="suggested_severity" invisible="not suggested_severity"/>
                            <field name="file_item_id"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="amount" invisible="route != 'b5'"/>
                            <field name="communicated_on" invisible="route != 'c1'"/>
                            <field name="created_by_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="detail"/>
                        <field name="recommendation"/>
                        <field name="management_response"/>
                        <field name="response" invisible="status != 'cleared'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_engagement_findings_board" model="ir.ui.view">
        <field name="name">ea.audit.engagement.findings.board</field>
        <field name="model">ea.audit.engagement</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_open_finding_wizard" type="object" string="New finding" class="btn-primary" groups="ea_audit_core.group_writer"/>
                    <button name="action_export_findings" type="object" string="Export to Excel"/>
                    <button name="action_tool_sad" type="object" string="Audit differences"/>
                    <field name="b5_exceeds" invisible="1"/>
                </header>
                <sheet>
                    <div class="o_ea_title">Findings</div>
                    <div class="o_ea_sub"><field name="display_name" readonly="1"/></div>
                    <div class="o_ea_cards">
                        <div class="o_ea_card">
                            <div class="o_ea_card_label">Uncorrected misstatements</div>
                            <field name="b5_uncorrected_label" class="o_ea_card_value"/>
                            <div class="o_ea_card_note" invisible="b5_exceeds"><field name="b5_uncorrected_note"/></div>
                            <div class="o_ea_card_note o_ea_card_bad" invisible="not b5_exceeds"><field name="b5_uncorrected_note"/></div>
                        </div>
                        <div class="o_ea_card">
                            <div class="o_ea_card_label">Significant deficiencies</div>
                            <field name="finding_significant_count" class="o_ea_card_value"/>
                            <div class="o_ea_card_note o_ea_card_bad" invisible="not finding_uncommunicated_count">
                                <field name="finding_uncommunicated_count"/> not communicated in writing: blocks the archive
                            </div>
                        </div>
                        <div class="o_ea_card">
                            <div class="o_ea_card_label">Open findings</div>
                            <field name="finding_open_count" class="o_ea_card_value"/>
                            <div class="o_ea_card_note">Out of <field name="finding_total_count"/> in all</div>
                        </div>
                    </div>
                    <div class="o_ea_panel">
                        <field name="finding_ids" readonly="1" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
