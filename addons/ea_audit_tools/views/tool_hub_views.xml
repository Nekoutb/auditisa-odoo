<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tool_tile_kanban" model="ir.ui.view">
        <field name="name">ea.audit.tool.tile.kanban</field>
        <field name="model">ea.audit.tool.tile</field>
        <field name="arch" type="xml">
            <kanban class="o_ea_hub" create="0" delete="0" edit="0" can_open="0" action="action_open_tool" type="object">
                <field name="enabled_method"/>
                <field name="feeds"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_ea_tile #{record.enabled_method.raw_value ? '' : 'o_ea_tile_off'}">
                            <span class="o_ea_tile_name"><field name="name"/></span>
                            <span class="o_ea_tile_desc"><field name="subtitle"/></span>
                            <div class="mt-2">
                                <t t-foreach="(record.feeds.raw_value || '').split(',')" t-as="code" t-key="code">
                                    <span class="o_ea_tile_code" t-if="code" t-esc="code"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_review_note_register" model="ir.ui.view">
        <field name="name">ea.audit.review.note.register</field>
        <field name="model">ea.audit.review.note</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="code" string="Task"/>
                <field name="body"/>
                <field name="author_id" string="Raised by"/>
                <field name="assignee_id"/>
                <field name="state"/>
                <field name="create_date" string="Raised on"/>
                <field name="cleared_at" string="Cleared on"/>
                <field name="response"/>
            </list>
        </field>
    </record>
    <record id="view_forms_register" model="ir.ui.view">
        <field name="name">ea.audit.file.item.forms.register</field>
        <field name="model">ea.audit.file.item</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" default_order="sequence, code" action="action_open_paper" type="object"
                  decoration-danger="preparer_id and preparer_id == approver_id" decoration-muted="scope_chip">
                <field name="code"/>
                <field name="short_title" string="Paper"/>
                <field name="scope_chip" widget="badge" decoration-warning="scope_chip" width="120px"/>
                <field name="scope_reason" optional="show"/>
                <field name="task_phase"/>
                <field name="preparer_id"/>
                <field name="approver_id"/>
                <field name="state"/>
                <field name="due_date"/>
                <field name="conditional_trigger"/>
            </list>
        </field>
    </record>

    <!-- The entry: on the engagement, next to its phase. -->
    <record id="view_engagement_form_tools_button" model="ir.ui.view">
        <field name="name">ea.audit.engagement.form.tools</field>
        <field name="model">ea.audit.engagement</field>
        <field name="inherit_id" ref="ea_audit_core.view_engagement_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='phase']" position="before">
                <button name="action_open_tools" type="object" string="Tools"/>
            </xpath>
        </field>
    </record>
    <!-- The Engagement team tile: members, role and status; a manager invites and sets roles. -->
    <record id="view_team_tool_list" model="ir.ui.view">
        <field name="name">ea.audit.team.member.tool.list</field>
        <field name="model">ea.audit.team.member</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" editable="bottom">
                <header>
                    <button name="action_ea_invite_member" type="object" string="Invite a member" class="btn-primary" display="always" groups="ea_audit_core.group_manager"/>
                </header>
                <field name="user_id" readonly="1"/>
                <field name="email" readonly="1"/>
                <field name="ea_role_locked" column_invisible="1"/>
                <field name="team_role" string="Role" readonly="ea_role_locked"/>
                <field name="state" readonly="1"/>
                <field name="invited_at" string="Invited on" readonly="1" optional="show"/>
                <field name="responded_at" string="Answered on" readonly="1" optional="show"/>
            </list>
        </field>
    </record>
</odoo>
