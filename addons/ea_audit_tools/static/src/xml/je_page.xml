<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ea_audit_tools.JePage">
        <div class="o_ea_ws o_ea_jet" t-if="p" data-ea="je-page">
            <div class="o_ea_ws_card">
                <EaCrumbs engagementId="engagementId" title.translate="Journal entry testing"/>
                <div class="o_ea_ws_head">
                    <div>
                        <div class="o_ea_ws_sub"><t t-esc="p.engagement"/> · <span>E3.1 · S5.4</span></div>
                        <h1>Journal entry testing</h1>
                        <p class="o_ea_ws_muted">ISA 240: test the appropriateness of journal entries recorded in the general ledger, focusing on those with characteristics of possible management override.</p>
                    </div>
                </div>

                <div class="o_ea_ws_readonly" t-if="p.readonly">
                    <t t-if="p.archived">Read only: this engagement is archived.</t>
                    <t t-else="">Read only: your role reads the entries but does not change them.</t>
                </div>

                <div class="o_ea_ws_kpis" data-ea="je-summary">
                    <div class="o_ea_ws_kpi is-good">
                        <span>General ledger in use</span>
                        <t t-if="p.ledger.ready">
                            <b><t t-esc="p.ledger.lines"/> <small>lines</small> · <t t-esc="p.ledger.entries"/> <small>entries</small></b>
                            <small t-esc="p.ledger.timing"/>
                        </t>
                        <b t-else="">—</b>
                    </div>
                    <div class="o_ea_ws_kpi is-warn">
                        <span>Entries selected</span>
                        <b t-esc="p.totals.selected"/>
                        <small>by at least one criterion</small>
                    </div>
                    <div t-attf-class="o_ea_ws_kpi {{ p.totals.exceptions ? 'is-bad' : 'is-good' }}">
                        <span>Tested</span>
                        <b><t t-esc="p.totals.tested"/> <small>of</small> <t t-esc="p.totals.selected"/></b>
                        <small><t t-esc="p.totals.clean"/> without exceptions · <t t-esc="p.totals.exceptions"/> with exceptions</small>
                    </div>
                    <div class="o_ea_ws_kpi">
                        <span>Findings raised</span>
                        <b t-esc="p.findings.length"/>
                        <small><t t-esc="p.adjustments.length"/> adjustments to the summary of audit differences</small>
                    </div>
                </div>

                <t t-if="!p.ledger.ready">
                    <p class="o_ea_ws_empty" t-if="p.ledger.missing === 'lines'">The ledger is imported but not prepared yet. Open it from the ledgers and run the console once.</p>
                    <p class="o_ea_ws_empty" t-else="">No general ledger is imported for this file yet. Import it from the ledgers, then come back.</p>
                    <button type="button" class="btn btn-secondary btn-sm" t-on-click="() => this.openLedgers()">The ledgers</button>
                </t>

                <div class="o_ea_with_docs" t-if="p.ledger.ready">
                <div class="o_ea_with_docs_main">
                <div class="o_ea_ws_split">
                    <aside class="o_ea_ws_side" data-ea="je-criteria">
                        <div class="o_ea_ws_caption">Criteria</div>
                        <div class="o_ea_jet_group" t-foreach="p.groups" t-as="group" t-key="group.key">
                            <div class="o_ea_jet_group_name" t-esc="group.name"/>
                            <label class="o_ea_jet_criterion" t-foreach="group.criteria" t-as="criterion" t-key="criterion.key">
                                <input type="checkbox" t-att-checked="isTicked(criterion.key)" t-on-change="() => this.tick(criterion.key)"/>
                                <span class="o_ea_jet_no" t-esc="criterion.no"/>
                                <span class="o_ea_ws_cname" t-esc="criterion.name"/>
                                <b class="o_ea_ws_num" t-esc="criterion.count"/>
                            </label>
                        </div>
                        <button type="button" class="btn btn-link btn-sm" t-if="state.ticked.length" t-on-click="() => this.clearCriteria()">Clear the criteria</button>
                        <p class="o_ea_ws_muted o_ea_jet_settings">
                            <t t-esc="p.settingsText"/>
                            <t t-if="!p.readonly and !state.settings"> · <a href="#" t-on-click.prevent="() => this.openSettings()">Change the settings</a></t>
                        </p>
                        <div class="o_ea_jet_settings_form" t-if="state.settings" data-ea="je-settings">
                            <label>Round amounts: multiples of <input type="text" class="form-control form-control-sm" t-model="state.settings.roundStep"/></label>
                            <label>Approval limit <input type="text" class="form-control form-control-sm" t-model="state.settings.approvalLimit"/></label>
                            <label>Band below the limit (%) <input type="text" class="form-control form-control-sm" t-model="state.settings.approvalBand"/></label>
                            <label>Cash expenses above <input type="text" class="form-control form-control-sm" t-model="state.settings.cashLimit"/></label>
                            <label>Days around the year end <input type="text" class="form-control form-control-sm" t-model="state.settings.yearEndDays"/></label>
                            <label>Rare poster: fewer than this share of entries (%) <input type="text" class="form-control form-control-sm" t-model="state.settings.rarePosterShare"/></label>
                            <label>Rare account: used in fewer entries than <input type="text" class="form-control form-control-sm" t-model="state.settings.rareAccountEntries"/></label>
                            <label>Vague description: shorter than (characters) <input type="text" class="form-control form-control-sm" t-model="state.settings.vagueMinChars"/></label>
                            <label>Vague words, separated by commas <textarea class="form-control form-control-sm" rows="2" t-model="state.settings.vagueWords"/></label>
                            <div class="o_ea_ws_caption">Public holidays of the year</div>
                            <ul class="o_ea_jet_holidays">
                                <li t-foreach="state.settings.holidays" t-as="h" t-key="h.date">
                                    <t t-esc="h.text"/> <t t-esc="h.label"/>
                                    <a href="#" t-on-click.prevent="() => this.removeHoliday(h.date)" title="Remove">×</a>
                                </li>
                            </ul>
                            <div class="o_ea_ws_row">
                                <input type="date" class="form-control form-control-sm" t-model="state.holiday.date"/>
                                <input type="text" class="form-control form-control-sm" t-model="state.holiday.label" placeholder="Holiday"/>
                                <button type="button" class="btn btn-secondary btn-sm" t-on-click="() => this.addHoliday()">Add the date</button>
                            </div>
                            <div class="o_ea_ws_tools">
                                <button type="button" class="btn btn-primary btn-sm" t-on-click="() => this.saveSettings()" t-att-disabled="state.busy">Save the settings</button>
                                <button type="button" class="btn btn-secondary btn-sm" t-on-click="() => this.state.settings = null">Cancel</button>
                            </div>
                        </div>
                    </aside>

                    <div class="o_ea_ws_main" data-ea="je-entries">
                        <div class="o_ea_ws_row">
                            <span class="o_ea_ws_caption">Selected entries <span class="o_ea_ws_count is-warn" t-esc="visible.length"/></span>
                            <button type="button" class="btn btn-secondary btn-sm" t-on-click="() => this.exportSelection()" t-att-disabled="!visible.length">Export the selection for the client (Excel)</button>
                        </div>
                        <p class="o_ea_ws_empty" t-if="!visible.length">No entry is selected by these criteria.</p>
                        <div class="o_ea_ws_scroll" t-if="visible.length">
                            <table class="o_ea_ws_grid is-clickable">
                                <thead>
                                    <tr>
                                        <th>Entry</th><th>Date</th><th>Journal</th><th>Accounts</th>
                                        <th class="text-end">Amount</th><th>Prepared / approved</th><th>Why selected</th><th>Test</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="shown" t-as="row" t-key="row.key">
                                        <tr t-attf-class="{{ row.key === state.current ? 'is-current' : '' }}" t-on-click="() => this.open(row)">
                                            <td class="o_ea_ws_strong" t-esc="row.je"/>
                                            <td><t t-esc="row.dateText"/> <small class="o_ea_ws_muted" t-esc="row.weekday"/></td>
                                            <td t-esc="row.journal"/>
                                            <td t-esc="row.accounts"/>
                                            <td class="o_ea_ws_num" t-esc="row.amountText"/>
                                            <td><t t-esc="row.preparer or '—'"/> / <t t-esc="row.approver or '—'"/></td>
                                            <td><span class="o_ea_ws_reason" t-foreach="row.reasons" t-as="reason" t-key="reason" t-esc="reasonName(row, reason)"/></td>
                                            <td><span t-attf-class="o_ea_ws_tag is-{{ row.test }}" t-esc="statusLabel(row.test)"/></td>
                                        </tr>
                                        <tr t-if="row.key === state.current and state.test" class="o_ea_jet_test_row">
                                            <td colspan="8"><t t-call="ea_audit_tools.JeTest"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <p class="o_ea_ws_muted" t-if="visible.length > shown.length" t-esc="moreText"/>
                        <p class="o_ea_ws_muted" t-if="p.truncated">The selection is too large to list in full: the counts above are complete.</p>
                    </div>
                </div>

                <div class="o_ea_jet_panels">
                    <div data-ea="je-findings">
                        <div class="o_ea_ws_caption">Findings from journal entry testing</div>
                        <p class="o_ea_ws_muted" t-if="!p.findings.length">No finding raised yet.</p>
                        <table class="o_ea_ws_grid" t-if="p.findings.length">
                            <thead><tr><th>Finding</th><th>Entry</th><th>Kind</th><th>Stage</th></tr></thead>
                            <tbody>
                                <tr t-foreach="p.findings" t-as="f" t-key="f.id">
                                    <td><b t-esc="f.ref"/> <t t-esc="f.title"/></td>
                                    <td t-esc="f.entry"/>
                                    <td t-esc="f.kind"/>
                                    <td><span t-attf-class="o_ea_ws_tag is-{{ f.tone }}" t-esc="f.stage"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div data-ea="je-adjustments">
                        <div class="o_ea_ws_caption">Adjustments to the summary of audit differences</div>
                        <p class="o_ea_ws_muted" t-if="!p.adjustments.length">No adjustment proposed yet.</p>
                        <table class="o_ea_ws_grid" t-if="p.adjustments.length">
                            <thead><tr><th>Entry</th><th>Heading</th><th>Adjustment proposed</th><th class="text-end">Amount</th><th>Status</th></tr></thead>
                            <tbody>
                                <tr t-foreach="p.adjustments" t-as="a" t-key="a.id">
                                    <td t-esc="a.entry"/>
                                    <td t-esc="a.heading"/>
                                    <td t-esc="a.proposed"/>
                                    <td class="o_ea_ws_num" t-esc="a.amount"/>
                                    <td t-esc="a.status"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="o_ea_jet_signoff" data-ea="je-signoff">
                    <div class="o_ea_ws_caption">Conclusion and sign-off</div>
                    <p>
                        <t t-esc="p.totals.tested"/> of <t t-esc="p.totals.selected"/> selected entries tested:
                        <t t-esc="p.totals.clean"/> without exceptions, <t t-esc="p.totals.exceptions"/> with exceptions.
                    </p>
                    <div class="o_ea_ws_tools">
                        <t t-foreach="p.signing" t-as="chip" t-key="chip.role">
                            <span t-if="chip.state === 'signed'" class="o_ea_ws_tag is-no_exception" t-esc="signedText(chip)"/>
                            <button t-else="" type="button" class="btn btn-primary btn-sm" t-att-disabled="chip.state !== 'open' or state.busy"
                                    t-att-title="chip.reason or ''" t-on-click="() => this.sign(chip)" t-esc="signLabel(chip)"/>
                        </t>
                    </div>
                    <t t-foreach="p.signing" t-as="chip" t-key="chip.role + '_why'">
                        <p class="o_ea_ws_muted" t-if="chip.state === 'refused'"><t t-esc="signLabel(chip)"/>: <t t-esc="chip.reason"/></p>
                    </t>
                </div>
                </div>
                <EaDocsPane engagementId="engagementId" docs="saved ? saved.fileList : undefined"
                            title.translate="Support" subject="row ? row.je + ' · ' + (row.description or '') : ''"
                            idleText.translate="Open an entry to see and file its support."
                            canUpload="!!row and !p.readonly"
                            onUpload.bind="attach" onAttach.bind="attachExisting"/>
                </div>
            </div>
        </div>
    </t>

    <t t-name="ea_audit_tools.JeTest">
        <div class="o_ea_ws_detail" data-ea="je-test">
            <div class="o_ea_ws_detail_head">
                <div>
                    <b t-esc="row.je"/> · <span t-esc="row.description or '—'"/> · <b t-esc="row.amountText"/>
                </div>
                <span t-attf-class="o_ea_ws_tag is-{{ row.test }}" t-esc="statusLabel(row.test)"/>
            </div>
            <table class="o_ea_jet_attributes">
                <tbody>
                    <tr t-foreach="p.attributes" t-as="attribute" t-key="attribute.key">
                        <td t-esc="attribute.label"/>
                        <td class="o_ea_jet_answers">
                            <button type="button" t-attf-class="btn btn-sm {{ state.test[attribute.key] === 'yes' ? 'btn-success' : 'btn-secondary' }}"
                                    t-att-disabled="p.readonly or state.busy" t-on-click.stop="() => this.answer(attribute.key, 'yes')">Yes</button>
                            <button type="button" t-attf-class="btn btn-sm {{ state.test[attribute.key] === 'no' ? 'btn-danger' : 'btn-secondary' }}"
                                    t-att-disabled="p.readonly or state.busy" t-on-click.stop="() => this.answer(attribute.key, 'no')">No</button>
                            <button type="button" t-attf-class="btn btn-sm {{ state.test[attribute.key] === 'na' ? 'btn-dark' : 'btn-secondary' }}"
                                    t-att-disabled="p.readonly or state.busy" t-on-click.stop="() => this.answer(attribute.key, 'na')">Not applicable</button>
                        </td>
                    </tr>
                </tbody>
            </table>
            <label class="o_ea_ws_label">Work done and result</label>
            <textarea class="form-control o_ea_ws_note" rows="3" t-model="state.test.work" t-att-readonly="p.readonly"
                      t-on-change="() => this.saveTest()" placeholder="What you checked and what you found. Cite the attachments as [A1], [A2]."/>
            <div class="o_ea_ws_muted" t-if="saved and saved.finding">Finding raised: <b t-esc="saved.finding"/></div>
            <div class="o_ea_ws_tools" t-if="!p.readonly">
                <button type="button" class="btn btn-secondary btn-sm" t-if="!state.finding" t-on-click="() => this.startFinding()">Raise a finding</button>
                <button type="button" class="btn btn-secondary btn-sm" t-if="!(saved and saved.adjustment)" t-on-click="() => this.startAdjustment()" t-att-disabled="state.busy">Add an adjustment</button>
            </div>
            <div class="o_ea_ws_finding" t-if="state.finding" data-ea="je-finding">
                <div class="o_ea_ws_row">
                    <label class="o_ea_ws_label">Kind of finding</label>
                    <select class="form-select form-select-sm o_ea_ws_select" t-model="state.finding.type">
                        <option value="misstatement">Misstatement (goes to the audit differences)</option>
                        <option value="matter">Matter for attention</option>
                        <option value="deficiency">Control deficiency</option>
                    </select>
                    <t t-if="state.finding.type === 'misstatement'">
                        <label class="o_ea_ws_label">Amount</label>
                        <input type="text" class="form-control form-control-sm o_ea_ws_amount" t-model="state.finding.amount"/>
                    </t>
                </div>
                <textarea class="form-control" rows="2" t-model="state.finding.description"/>
                <label class="o_ea_ws_check" t-if="state.finding.type === 'misstatement'">
                    <input type="checkbox" t-model="state.finding.trivial"/>
                    <span>Record it even if it is below the clearly trivial threshold</span>
                </label>
                <div class="o_ea_ws_tools">
                    <button type="button" class="btn btn-primary btn-sm" t-on-click="() => this.raiseFinding()" t-att-disabled="state.busy">Raise the finding</button>
                    <button type="button" class="btn btn-secondary btn-sm" t-on-click="() => this.state.finding = null">Cancel</button>
                </div>
            </div>
            <div t-if="saved and saved.adjustment" data-ea="je-adjustment">
                <EaAdjustment adj="saved.adjustment" readonly="p.readonly" onSave.bind="saveAdjustment"/>
            </div>
        </div>
    </t>
</templates>
