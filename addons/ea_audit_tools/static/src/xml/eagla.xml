<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- EAGLA's left pane: four lines that roll down and up (mock-up "eagla-results-first", 18/11/2026).
         Every word comes from the server, already translated. -->
    <t t-name="ea_audit_tools.EaEaglaNav">
        <div class="o_ea_eagla_side" data-ea="eagla-nav">
            <button type="button" class="o_ea_eagla_row" t-on-click="() => this.openScreen('action_eagla_financial')">
                <span class="o_ea_eagla_ar">▸</span><t t-esc="nav.financial"/>
            </button>
            <button type="button" class="o_ea_eagla_row" t-on-click="() => this.openScreen('action_eagla_analytical')">
                <span class="o_ea_eagla_ar">▸</span><t t-esc="nav.analytical"/>
            </button>
            <button type="button" t-att-class="state.open === 'analyses' ? 'o_ea_eagla_row is-open' : 'o_ea_eagla_row'"
                    t-att-aria-expanded="state.open === 'analyses' ? 'true' : 'false'" t-on-click="() => this.toggle('analyses')">
                <span class="o_ea_eagla_ar" t-esc="state.open === 'analyses' ? '▾' : '▸'"/><t t-esc="nav.analyses"/>
                <span class="o_ea_eagla_ct" t-esc="analysisList.length"/>
            </button>
            <div class="o_ea_eagla_list is-long" t-if="state.open === 'analyses'" data-ea="eagla-analyses">
                <t t-foreach="analysisList" t-as="item" t-key="item[0]">
                    <a href="#" t-att-class="isAnalysis(item[0]) ? 'is-on' : ''" t-att-data-key="item[0]"
                       t-on-click.prevent="() => this.pick(item[0])" t-esc="item[1]"/>
                </t>
            </div>
            <button type="button" t-att-class="state.open === 'scot' ? 'o_ea_eagla_row is-open' : 'o_ea_eagla_row'"
                    t-att-aria-expanded="state.open === 'scot' ? 'true' : 'false'" t-on-click="() => this.toggle('scot')">
                <span class="o_ea_eagla_ar" t-esc="state.open === 'scot' ? '▾' : '▸'"/><t t-esc="nav.scot"/>
                <span class="o_ea_eagla_ct" t-esc="scotList.length"/>
            </button>
            <div class="o_ea_eagla_list" t-if="state.open === 'scot'" data-ea="eagla-scot">
                <t t-foreach="scotList" t-as="item" t-key="item[0]">
                    <a href="#" t-att-class="isScot(item[0]) ? 'is-on' : ''" t-att-data-key="item[0]"
                       t-on-click.prevent="() => this.scot(item[0])" t-esc="item[1]"/>
                </t>
            </div>
        </div>
    </t>

    <!-- A result that lists entries or lines: tick them for testing, open an entry's lines, extract. -->
    <t t-name="ea_audit_tools.EaEaglaItems">
        <div class="o_ea_eagla_items" data-ea="eagla-items">
            <div class="o_ea_eagla_bar">
                <button type="button" class="btn btn-secondary btn-sm" t-on-click="tickAll" t-esc="items.labels.tickAll"/>
                <button type="button" class="btn btn-secondary btn-sm" t-on-click="untickAll" t-esc="items.labels.untickAll"/>
                <span class="o_ea_eagla_sel" data-ea="eagla-counter" t-esc="counter"/>
                <span class="ms-auto"/>
                <button type="button" class="btn btn-primary btn-sm" t-att-disabled="!tickedCount" t-on-click="extractSelection" t-esc="extractLabel"/>
                <button type="button" class="btn btn-secondary btn-sm" t-on-click="extractAll" t-esc="items.labels.extractAll"/>
            </div>
            <div class="table-responsive">
                <table class="table table-sm o_ea_table o_ea_eagla_ticks">
                    <thead>
                        <tr>
                            <th class="o_ea_eagla_tick"/>
                            <t t-foreach="items.columns" t-as="col" t-key="col_index">
                                <th t-att-class="col.num ? 'text-end' : ''" t-esc="col.label"/>
                            </t>
                            <th t-if="isEntry"/>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="items.rows" t-as="row" t-key="row.key">
                            <tr t-att-class="isTicked(row) ? 'o_ea_eagla_ticked' : ''">
                                <td class="o_ea_eagla_tick">
                                    <input type="checkbox" class="form-check-input" t-att-checked="isTicked(row)" t-on-change="() => this.toggleRow(row)"/>
                                </td>
                                <t t-foreach="row.cells" t-as="cell" t-key="cell_index">
                                    <td t-att-class="items.columns[cell_index].num ? 'text-end' : ''">
                                        <b t-if="cell_index === 0" t-esc="cell"/>
                                        <t t-else="" t-esc="cell"/>
                                    </td>
                                </t>
                                <td t-if="isEntry" class="text-nowrap">
                                    <button type="button" class="btn btn-link btn-sm p-0 o_ea_eagla_view" t-on-click="() => this.toggleLines(row)">
                                        <t t-esc="isOpen(row) ? '▾' : '▸'"/> <t t-esc="items.labels.lines"/>
                                    </button>
                                </td>
                            </tr>
                            <t t-if="isEntry and isOpen(row)">
                                <t t-foreach="linesOf(row)" t-as="line" t-key="line_index">
                                    <tr class="o_ea_eagla_det">
                                        <td/>
                                        <td colspan="3" t-esc="line.account"/>
                                        <td t-esc="line.description"/>
                                        <td class="text-end" t-esc="line.debit"/>
                                        <td class="text-end" t-esc="line.credit"/>
                                        <td/>
                                        <td/>
                                    </tr>
                                </t>
                                <tr class="o_ea_eagla_det" t-if="!linesOf(row).length">
                                    <td/>
                                    <td colspan="8" t-esc="items.labels.noLines"/>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>
            <p class="o_ea_legend" t-if="items.more" t-esc="items.more"/>
        </div>
    </t>
</templates>
