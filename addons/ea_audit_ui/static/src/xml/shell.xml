<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ea_audit_ui.WebClient" t-inherit="web.WebClient" t-inherit-mode="extension">
        <xpath expr="//NavBar" position="replace">
            <EaTopBar t-if="eaShell"/>
            <NavBar t-else=""/>
        </xpath>
    </t>

    <t t-name="ea_audit_ui.TopBar">
        <header class="ea-top">
            <a class="ea-brand" href="#" role="button" title="Dashboard" t-on-click.prevent="goHome">
                <span class="ea-logo">A</span>
                <span class="ea-firm" t-esc="shell.firm"/>
            </a>
            <nav class="ea-nav" aria-label="Main navigation">
                <t t-if="inMission">
                    <a t-foreach="phases" t-as="phase" t-key="phase.key" href="#" role="button"
                       t-att-class="{on: currentSection === phase.key}"
                       t-on-click.prevent="() => this.goPhase(phase.key)" t-esc="phase.label"/>
                </t>
                <t t-else="">
                    <a href="#" role="button" t-att-class="{on: ctxState.screen === 'home'}" t-on-click.prevent="goHome">Dashboard</a>
                    <a href="#" role="button" t-att-class="{on: ctxState.screen === 'missions'}" t-on-click.prevent="goMissions">Engagements</a>
                </t>
            </nav>
            <div class="ea-sp"/>

            <div class="ea-anchor ea-sel-wrap" data-ea-panel="selector">
                <button type="button" class="ea-sel" t-att-aria-expanded="state.open === 'selector' ? 'true' : 'false'" t-on-click="toggleSelector">
                    <small>ENGAGEMENTS</small>
                    <span class="ea-sel-line"><b t-esc="selectorLabel"/><i class="ea-caret">&#9662;</i></span>
                </button>
                <div t-if="state.open === 'selector'" class="ea-pop ea-pop-sel">
                    <div class="ea-pop-h">Recent engagements</div>
                    <a t-foreach="recentMissions" t-as="mission" t-key="mission.id" class="ea-pop-row" href="#" role="button"
                       t-on-click.prevent="() => this.pickMission(mission)">
                        <b t-esc="mission.label"/>
                        <small t-esc="mission.phase_label"/>
                    </a>
                    <div t-if="!ctxState.recent.length" class="ea-pop-empty">No engagements: you are not a member of any team.</div>
                    <a class="ea-pop-foot" href="#" role="button" t-on-click.prevent="goMissions">All engagements &#8594;</a>
                </div>
            </div>

            <div class="ea-anchor ea-search-wrap" data-ea-panel="search">
                <input class="ea-search" type="search" placeholder="Search…" aria-label="Search for an engagement or a task"
                       t-att-value="state.query" t-on-input="onSearchInput" t-on-focus="onSearchFocus"/>
                <div t-if="state.open === 'search' and state.results" class="ea-pop ea-pop-search">
                    <t t-if="state.results.missions.length">
                        <div class="ea-pop-h">Engagements</div>
                        <a t-foreach="state.results.missions" t-as="mission" t-key="mission.id" class="ea-pop-row" href="#" role="button"
                           t-on-click.prevent="() => this.pickMission(mission)">
                            <b t-esc="mission.label"/>
                            <small t-esc="mission.phase_label"/>
                        </a>
                    </t>
                    <t t-if="state.results.tasks.length">
                        <div class="ea-pop-h">Tasks</div>
                        <a t-foreach="state.results.tasks" t-as="task" t-key="task.id" class="ea-pop-row" href="#" role="button"
                           t-on-click.prevent="() => this.pickTask(task)">
                            <b><code t-esc="task.code"/> <t t-esc="task.title"/></b>
                            <small t-esc="task.mission"/>
                        </a>
                    </t>
                    <div t-if="!state.results.missions.length and !state.results.tasks.length" class="ea-pop-empty">No results.</div>
                </div>
            </div>

            <button t-if="inMission" type="button" class="ea-ic" aria-label="Tools" title="Engagement tools" t-on-click="openTools">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </button>

            <button t-foreach="inMission ? [] : quickApps" t-as="app" t-key="app.key" type="button" class="ea-ic" t-att-aria-label="app.label" t-att-title="app.label" t-att-class="{on: ctxState.screen === app.key}" t-on-click="() => this.openApp(app)">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </button>

            <div class="ea-anchor" data-ea-panel="apps">
                <button type="button" class="ea-ic" aria-label="Apps" title="Apps" t-att-aria-expanded="state.open === 'apps' ? 'true' : 'false'" t-on-click="() => this.toggle('apps')">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><circle cx="5" cy="5" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="12" cy="19" r="2"/><circle cx="19" cy="19" r="2"/></svg>
                </button>
                <div t-if="state.open === 'apps'" class="ea-pop ea-pop-gear">
                    <div class="ea-pop-h">Apps</div>
                    <a t-foreach="apps" t-as="app" t-key="app.key" class="ea-pop-row" href="#" role="button"
                       t-att-data-ea-app="app.key" t-on-click.prevent="() => this.openApp(app)">
                        <b t-esc="app.label"/>
                        <small t-esc="app.sub"/>
                    </a>
                </div>
            </div>

            <div class="ea-anchor" data-ea-panel="bell">
                <button type="button" class="ea-ic" aria-label="Notifications" t-att-aria-expanded="state.open === 'bell' ? 'true' : 'false'" t-on-click="toggleBell">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                    <span t-if="ctxState.unread" class="ea-badge" t-esc="ctxState.unread"/>
                </button>
                <div t-if="state.open === 'bell'" class="ea-pop ea-pop-bell">
                    <div class="ea-pop-h">Notifications<t t-if="ctxState.unread">, <t t-esc="unreadLabel"/></t></div>
                    <div class="ea-pop-scroll">
                        <a t-foreach="state.notifications" t-as="row" t-key="row.id" class="ea-pop-row ea-note" href="#" role="button"
                           t-att-class="{unread: row.unread}" t-on-click.prevent="() => this.openNotification(row)">
                            <b t-esc="row.title"/>
                            <small><t t-esc="row.detail"/> · <t t-esc="timeAgo(row.created)"/></small>
                        </a>
                        <div t-if="!state.notifications.length" class="ea-pop-empty">No notifications.</div>
                    </div>
                </div>
            </div>

            <div class="ea-anchor" data-ea-panel="gear">
                <button type="button" class="ea-ic" aria-label="Settings" t-att-aria-expanded="state.open === 'gear' ? 'true' : 'false'" t-on-click="() => this.toggle('gear')">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.08a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.08a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                </button>
                <div t-if="state.open === 'gear'" class="ea-pop ea-pop-gear">
                    <div class="ea-pop-h">Settings</div>
                    <a t-foreach="gearItems" t-as="item" t-key="item.label" class="ea-pop-row ea-pop-simple" href="#" role="button"
                       t-on-click.prevent="() => this.runGear(item)" t-esc="item.label"/>
                </div>
            </div>

            <div class="ea-lang" role="group" aria-label="Language">
                <button type="button" class="ea-lang-b" t-att-class="{on: language === 'en_US'}" t-att-aria-pressed="language === 'en_US' ? 'true' : 'false'" t-on-click="() => this.setLanguage('en_US')">EN</button>
                <button type="button" class="ea-lang-b" t-att-class="{on: language === 'fr_FR'}" t-att-aria-pressed="language === 'fr_FR' ? 'true' : 'false'" t-on-click="() => this.setLanguage('fr_FR')">FR</button>
            </div>
            <div class="ea-who"><t t-esc="shell.name"/><small t-esc="shell.role"/></div>
            <div class="ea-av" t-esc="shell.initials"/>
            <a class="ea-out" href="/web/session/logout" aria-label="Sign out">
                <span class="ea-out-text">Sign out</span>
                <svg class="ea-out-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
            </a>
        </header>
    </t>

    <t t-name="ea_audit_ui.Home">
        <div class="ea-page">
            <div class="ea-narrow" t-if="state.loaded">
                <div class="ea-head">
                    <div>
                        <h1>Welcome, <t t-esc="shell.first_name"/></h1>
                        <div class="ea-sub">Your engagements.</div>
                    </div>
                    <button t-if="shell.can_write" type="button" class="ea-btn" t-on-click="newMission">+ New engagement</button>
                </div>

                <div class="ea-card ea-todo" t-if="state.todo.length">
                    <div class="ea-cardh">To do <span class="ea-count" t-esc="state.todo.length"/></div>
                    <a t-foreach="state.todo" t-as="row" t-key="row_index" class="ea-row" href="#" role="button" t-on-click.prevent="() => this.openTodo(row)">
                        <span><b t-esc="row.title"/> · <t t-esc="row.mission"/></span>
                        <span class="ea-count"><t t-if="row.count"><t t-esc="row.count"/> </t>&#8594;</span>
                    </a>
                </div>

                <div class="ea-card ea-missions">
                    <a t-foreach="state.missions" t-as="mission" t-key="mission.id" class="ea-mis" href="#" role="button" t-on-click.prevent="() => this.openMission(mission)">
                        <div>
                            <b><t t-esc="mission.client"/>, <t t-esc="mission.period_end"/><t t-if="mission.nature">, <t t-esc="mission.nature"/></t></b>
                            <div class="ea-m" t-if="mission.archived">
                                <t t-if="mission.archived_on">Archived on <t t-esc="mission.archived_on"/></t><t t-else="">Archived</t><br/>
                                <t t-esc="mission.partner"/> · File locked
                            </div>
                            <div class="ea-m" t-else="">
                                <t t-esc="mission.phase_label"/> · Phase deadline <t t-esc="mission.phase_deadline"/><br/>
                                Report due by <b t-esc="mission.report_due"/> · <t t-esc="mission.partner"/> · <t t-if="mission.acceptance_signed">Acceptance signed</t><t t-else="">Acceptance to sign</t>
                            </div>
                        </div>
                        <div class="ea-bar"><i t-attf-style="width: {{mission.pct}}%"/></div>
                        <div class="ea-pct"><t t-esc="mission.pct"/>%</div>
                        <div class="ea-go"><t t-if="mission.archived">Open</t><t t-else="">Continue</t> &#8594;</div>
                    </a>
                    <div t-if="!state.missions.length" class="ea-empty">
                        No engagements. You only see the engagements whose team you belong to.
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="ea_audit_ui.Dashboard">
        <div class="ea-page">
            <t t-if="state.data">
                <t t-set="d" t-value="state.data"/>
                <div class="ea-title">
                    <div>
                        <h1><t t-esc="d.mission.client"/>, fiscal year <t t-esc="d.mission.fiscal_year"/></h1>
                        <div class="ea-sub ea-dots">
                            <span t-esc="d.mission.phase_label"/>
                            <span>Period end <t t-esc="d.period_end"/></span>
                            <span>Report due by <t t-esc="d.report_due"/></span>
                            <span><a class="ea-link" href="#" role="button" t-on-click.prevent="openClient">About the client &#8594;</a></span>
                        </div>
                    </div>
                    <div class="ea-big">
                        <small>OVERALL COMPLETION</small>
                        <b><t t-esc="d.pct"/>%</b>
                    </div>
                </div>

                <div class="ea-rings" t-att-class="{open: openSection}" t-att-style="gridStyle">
                    <t t-foreach="d.rings" t-as="ring" t-key="ring.key">
                        <button type="button" class="ea-card ea-ring-card" t-att-class="{on: openSection === ring.key}"
                                t-att-aria-expanded="openSection === ring.key ? 'true' : 'false'" t-on-click="() => this.toggleRing(ring)">
                            <h3 t-esc="ring.label"/>
                            <div class="ea-ring" t-att-style="ringStyle(ring)"><div><t t-esc="ring.pct"/>%</div></div>
                        </button>
                        <div t-if="openSection === ring.key" class="ea-card ea-groups">
                            <a t-foreach="ring.groups" t-as="group" t-key="group.id" href="#" role="button"
                               t-att-class="{cur: ring.current_group === group.id}" t-on-click.prevent="() => this.openGroup(group)">
                                <b t-esc="group.label"/>
                                <span><t t-esc="group.done"/>/<t t-esc="group.total"/></span>
                            </a>
                            <div t-if="!ring.groups.length" class="ea-empty">No tasks on this engagement.</div>
                        </div>
                    </t>
                </div>

                <div class="ea-alert" t-if="d.unassigned_ids.length">
                    &#9888; <t t-esc="d.unassigned_ids.length"/> <t t-if="d.unassigned_ids.length > 1">tasks have no preparer.</t><t t-else="">task has no preparer.</t><t t-out="' '"/><a href="#" role="button" t-on-click.prevent="openUnassigned"><b>Assign them &#8594;</b></a>
                </div>

                <div class="ea-strip" t-if="d.attention.length">
                    <b>REQUIRES YOUR ATTENTION</b>
                    <a t-foreach="d.attention" t-as="chip" t-key="chip_index" class="ea-chip" href="#" role="button" t-att-class="{r: chip.tone === 'r'}"
                       t-on-click.prevent="() => this.openItem(chip.id)">
                        <code t-esc="chip.code"/><t t-esc="chip.title"/>, <t t-esc="chip.text"/>
                    </a>
                </div>

                <div class="ea-tiles">
                    <div class="ea-card ea-tile">
                        <h4>My tasks <small>assigned to me</small> <span t-esc="d.my_tasks.count"/></h4>
                        <a t-foreach="d.my_tasks.rows" t-as="row" t-key="row.id" class="ea-tl" href="#" role="button" t-on-click.prevent="() => this.openItem(row.id)">
                            <span><t t-esc="row.code"/> <t t-esc="row.title"/></span>
                            <span class="ea-tl-r" t-esc="row.word"/>
                        </a>
                        <div t-if="!d.my_tasks.rows.length" class="ea-empty">Nothing open is assigned to you on this file.</div>
                    </div>
                    <div class="ea-card ea-tile">
                        <h4>Review notes &amp; findings</h4>
                        <a class="ea-tl" href="#" role="button" data-tile="notes-for-me" t-on-click.prevent="openNotes"><span>Notes for me</span><b t-esc="d.notes.for_me"/></a>
                        <div class="ea-tl" data-tile="notes-by-me"><span>Notes by me</span><b t-esc="d.notes.by_me"/></div>
                        <a class="ea-tl" href="#" role="button" data-tile="deficiencies" t-on-click.prevent="() => this.openTool('action_tool_deficiencies')"><span>Deficiencies</span><b t-esc="d.notes.deficiencies"/></a>
                        <a class="ea-tl" href="#" role="button" data-tile="misstatements" t-on-click.prevent="() => this.openTool('action_tool_findings')"><span>Misstatements</span><b t-esc="d.notes.misstatements"/></a>
                    </div>
                    <div class="ea-card ea-tile">
                        <h4>Calendar <span t-if="d.calendar.late" class="ea-pill"><t t-esc="d.calendar.late"/> overdue</span></h4>
                        <a t-foreach="d.calendar.rows" t-as="row" t-key="row.id" class="ea-tl" href="#" role="button" t-on-click.prevent="() => this.openItem(row.id)">
                            <span>
                                <t t-esc="row.code"/> <t t-esc="row.title"/><br/>
                                <span t-if="row.late_days" class="ea-late"><t t-esc="row.late_text"/>, <t t-esc="row.due"/></span>
                                <span t-else="" class="ea-muted" t-esc="row.due"/>
                            </span>
                            <span class="ea-tl-r" t-esc="row.status"/>
                        </a>
                        <div t-if="!d.calendar.rows.length" class="ea-empty">No open deadlines.</div>
                    </div>
                </div>
            </t>
        </div>
    </t>

    <t t-name="ea_audit_ui.SignerCell">
        <span class="ea-k" t-att-class="chipClass" t-esc="chip"/>
        <span class="ea-cell">
            <t t-esc="cell.name"/>
            <small t-if="cell.detail" t-esc="cell.detail"/>
        </span>
    </t>

    <t t-name="ea_audit_ui.Tasks">
        <div class="ea-page">
            <t t-if="state.data">
                <t t-set="d" t-value="state.data"/>
                <a class="ea-back" href="#" role="button" t-on-click.prevent="back">&#8592; Back to dashboard</a>
                <div class="ea-title ea-title-tasks">
                    <div>
                        <h1><t t-esc="d.group.code"/> <t t-esc="d.group.title"/></h1>
                        <div class="ea-sub ea-dots">
                            <span t-esc="d.group.section_label"/>
                            <span t-esc="d.mission.client"/>
                            <span>Fiscal year <t t-esc="d.mission.fiscal_year"/></span>
                        </div>
                    </div>
                    <div class="ea-big">
                        <small>COMPLETION</small>
                        <b><t t-esc="d.done"/>/<t t-esc="d.total"/></b>
                    </div>
                </div>
                <div class="ea-card ea-task-card">
                    <div class="ea-cardh">Task list <span class="ea-sub"><t t-esc="d.total"/> <t t-if="d.total > 1">active tasks</t><t t-else="">active task</t></span></div>
                    <div class="ea-table-wrap">
                        <table class="ea-table">
                            <thead>
                                <tr><th>TASK</th><th>PREPARER</th><th>REVIEWER</th><th>PARTNER</th><th>DUE DATE</th><th>STATUS</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="d.rows" t-as="row" t-key="row.id" t-on-click="() => this.openRow(row)">
                                    <td class="ea-task-cell"><code t-esc="row.code"/><t t-esc="row.title"/></td>
                                    <td><t t-call="ea_audit_ui.SignerCell"><t t-set="cell" t-value="row.preparer"/><t t-set="chip" t-value="'P'"/><t t-set="chipClass" t-value="row.preparer.signed ? '' : 'n'"/></t></td>
                                    <td><t t-call="ea_audit_ui.SignerCell"><t t-set="cell" t-value="row.reviewer"/><t t-set="chip" t-value="'R'"/><t t-set="chipClass" t-value="row.reviewer.signed ? 'b' : 'n'"/></t></td>
                                    <td>
                                        <t t-if="row.partner"><t t-call="ea_audit_ui.SignerCell"><t t-set="cell" t-value="row.partner"/><t t-set="chip" t-value="'A'"/><t t-set="chipClass" t-value="'a'"/></t></t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td>
                                        <t t-esc="row.due"/>
                                        <span t-if="row.late_days" class="ea-late"><br/><t t-esc="row.late_text"/></span>
                                    </td>
                                    <td><span class="ea-st" t-att-class="row.tone" t-esc="row.pill"/></td>
                                </tr>
                                <tr t-if="!d.rows.length" class="ea-norow"><td colspan="6" class="ea-empty">No active tasks in this group.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
