<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The sign-in, sign-up and new-password pages look like the firm's AuditISA, not Odoo
         (owner, 2026-11-17). Looks only: the tokens and the sign-up rules are Odoo's, unchanged. -->

    <!-- No "Powered by Odoo" under the card. A database-manager link, where one is allowed,
         keeps its footer; otherwise there is no footer at all. -->
    <template id="login_layout_no_odoo" inherit_id="web.login_layout" name="AuditISA sign-in footer">
        <xpath expr="//a[contains(@href, 'www.odoo.com')]" position="replace"/>
        <xpath expr="//div[@t-if='not disable_footer']" position="attributes">
            <attribute name="t-if">not disable_footer and not disable_database_manager</attribute>
        </xpath>
    </template>

    <!-- No "Use a Passkey" button on the sign-in and sign-up pages. Runs after auth_passkey's
         own addition (higher priority), and filters it out by its class. -->
    <template id="login_no_passkey" inherit_id="web.login_oauth" name="AuditISA no passkey button" priority="99">
        <xpath expr="//div[hasclass('o_login_auth')]" position="before">
            <t t-set="auth_btns" t-value="[b for b in auth_btns if b.get('list_item_class') != 'passkey_login_link']"/>
        </xpath>
    </template>

    <!-- The page an invitation link opens: welcome to the firm, choose a password. -->
    <template id="signup_welcome" inherit_id="auth_signup.signup" name="AuditISA invitation page">
        <xpath expr="//form[hasclass('oe_signup_form')]/input[@name='csrf_token']" position="after">
            <t t-set="ea_firm" t-value="request.env.company.sudo()"/>
            <div t-if="token and not invalid_token" class="ea-signup-welcome text-center mb-4">
                <p class="text-muted small text-uppercase fw-bold mb-1">Welcome to</p>
                <h4 class="mb-2" t-esc="('ea_display_name' in ea_firm and ea_firm.ea_display_name) or ea_firm.name"/>
                <p class="text-muted small mb-0">Choose your password to finish setting up your account.</p>
            </div>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="t-att-readonly">'readonly' if token and not invalid_token and login else None</attribute>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit']" position="replace">
            <button type="submit" class="btn btn-primary mb-1">Set my password</button>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]/a[contains(@t-attf-href, '/web/login')]" position="replace"/>
    </template>

    <!-- The page a new-password link opens. -->
    <template id="reset_password_welcome" inherit_id="auth_signup.reset_password" name="AuditISA new password page">
        <xpath expr="//form[hasclass('oe_reset_password_form')]/input[@name='csrf_token']" position="after">
            <t t-set="ea_firm" t-value="request.env.company.sudo()"/>
            <div t-if="token and not invalid_token" class="ea-signup-welcome text-center mb-4">
                <p class="text-muted small text-uppercase fw-bold mb-1">Welcome to</p>
                <h4 class="mb-2" t-esc="('ea_display_name' in ea_firm and ea_firm.ea_display_name) or ea_firm.name"/>
                <p class="text-muted small mb-0">Choose a new password for your account.</p>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit']" position="attributes">
            <attribute name="t-if">not (token and not invalid_token)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit']" position="before">
            <button t-if="token and not invalid_token" type="submit" class="btn btn-primary">Save my new password</button>
        </xpath>
    </template>
</odoo>
