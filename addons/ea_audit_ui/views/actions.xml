<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The landing action of audit users (see ir_http.session_info). -->
    <record id="action_home" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">ea_audit_ui.home</field>
        <field name="path">ea-home</field>
    </record>
    <!-- The user manual (static pages in static/manual), opened by "? Help" in the top bar. -->
    <record id="action_help" model="ir.actions.client">
        <field name="name">User manual</field>
        <field name="tag">ea_audit_ui.help</field>
        <field name="path">ea-help</field>
    </record>
    <record id="view_notification_list" model="ir.ui.view">
        <field name="name">ea.audit.notification.list</field>
        <field name="model">ea.audit.notification</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" action="action_open_row" type="object" decoration-bf="not read_at">
                <field name="read_at" column_invisible="1"/>
                <field name="title"/>
                <field name="detail"/>
                <field name="kind"/>
                <field name="create_date" string="Date"/>
            </list>
        </field>
    </record>
    <record id="action_notifications" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">ea.audit.notification</field>
        <field name="view_mode">list</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>
</odoo>
