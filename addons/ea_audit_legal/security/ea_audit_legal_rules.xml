<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- F008: only an accepted member of the team reads these. Global rules. -->
    <record id="rule_deadline_team_only" model="ir.rule">
        <field name="name">ea.audit.legal.deadline: accepted team members only</field>
        <field name="model_id" ref="model_ea_audit_legal_deadline"/>
        <field name="domain_force">[('engagement_id.team_member_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted')])]</field>
    </record>
