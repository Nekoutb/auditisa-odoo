<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_note_list" model="ir.ui.view">
        <field name="name">ea.client.sample.note.list</field>
        <field name="model">ea.client.sample.note</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="reviewed"/>
                <button name="action_mark_reviewed" type="object" string="Mark as reviewed" invisible="reviewed"/>
            </list>
        </field>
    </record>
    <record id="action_note" model="ir.actions.act_window">
        <field name="name">SAMPLE: Client notes</field>
        <field name="res_model">ea.client.sample.note</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_note" name="SAMPLE: Client notes" action="action_note" sequence="90" groups="group_feature"/>
</odoo>
