<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report a problem -->
    <record id="view_support_ticket_form" model="ir.ui.view">
        <field name="name">ea.firm.support.ticket.form</field>
        <field name="model">ea.firm.support.ticket</field>
        <field name="arch" type="xml">
            <form string="Report a problem">
                <header>
                    <button name="action_refresh" type="object" string="Check for a reply" invisible="not id"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        This goes to the operator of AuditISA, the company that runs this software, not to your firm.
                    </div>
                    <div class="alert alert-warning" role="alert">
                        Do not write client details: no client name, no amount, no document content. Describe the screen and what you did.
                    </div>
                    <group>
                        <field name="subject" readonly="id" placeholder="The screen and the problem, in a few words"/>
                        <field name="message" readonly="id" placeholder="What you did, what you expected, what happened."/>
                        <field name="screen" invisible="not screen"/>
                    </group>
                    <group invisible="not reply">
                        <field name="reply"/>
                        <field name="replied_at"/>
                    </group>
                    <group invisible="not id">
                        <field name="sent_at"/>
                        <field name="ref"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_support_ticket_list" model="ir.ui.view">
        <field name="name">ea.firm.support.ticket.list</field>
        <field name="model">ea.firm.support.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Reported on"/>
                <field name="subject"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-info="state in ('open', 'in_progress')"/>
                <field name="reply"/>
            </list>
        </field>
    </record>
    <record id="rule_support_ticket_own" model="ir.rule">
        <field name="name">A user sees the problems they reported</field>
        <field name="model_id" ref="model_ea_firm_support_ticket"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="action_support_ticket_new" model="ir.actions.act_window">
        <field name="name">Report a problem</field>
        <field name="res_model">ea.firm.support.ticket</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_support_tickets" model="ir.actions.act_window">
        <field name="name">My reported problems</field>
        <field name="res_model">ea.firm.support.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Support visits: numbered, read-only, never edited -->
    <record id="view_support_visit_list" model="ir.ui.view">
        <field name="name">ea.firm.support.visit.list</field>
        <field name="model">ea.firm.support.visit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="state == 'open'">
                <field name="platform_ref"/>
                <field name="operator"/>
                <field name="reason"/>
                <field name="state" widget="badge" decoration-warning="state == 'open'"/>
                <field name="opened_at"/>
                <field name="ends_at"/>
                <field name="ended_at"/>
                <field name="release" optional="hide"/>
                <field name="logins"/>
                <button name="action_end" type="object" string="End now" class="btn-danger" invisible="state != 'open'"/>
            </list>
        </field>
    </record>
    <record id="view_support_visit_form" model="ir.ui.view">
        <field name="name">ea.firm.support.visit.form</field>
        <field name="model">ea.firm.support.visit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_end" type="object" string="End now" class="btn-danger" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        The operator reads as "AuditISA support (operator, not a firm user)" and can change nothing.
                        This record cannot be edited or deleted.
                    </div>
                    <group>
                        <group>
                            <field name="platform_ref"/>
                            <field name="operator"/>
                            <field name="reason"/>
                            <field name="release"/>
                        </group>
                        <group>
                            <field name="opened_at"/>
                            <field name="ends_at"/>
                            <field name="ended_at"/>
                            <field name="ended_by"/>
                            <field name="logins"/>
                        </group>
                    </group>
                    <field name="trace_ids">
                        <list>
                            <field name="opened_at"/>
                            <field name="model"/>
                            <field name="method"/>
                            <field name="res_ids"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_support_visits" model="ir.actions.act_window">
        <field name="name">Support visits</field>
        <field name="res_model">ea.firm.support.visit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>No support visit yet.</p>
            <p>When the operator needs to see your firm's screens, a numbered visit shows here, with the screens opened.
               The operator then reads as "AuditISA support (operator, not a firm user)" until the visit ends, and can change nothing.
               You can end it at any time.</p>
        </field>
    </record>
    <menuitem id="menu_support_visits" name="Support visits" parent="base.menu_administration"
              action="action_support_visits" sequence="91" groups="base.group_system"/>

    <record id="cron_support_expire" model="ir.cron">
        <field name="name">AuditISA: end support visits whose time is up</field>
        <field name="model_id" ref="model_ea_firm_support_visit"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_support_sync" model="ir.cron">
        <field name="name">AuditISA: send reported problems and fetch replies</field>
        <field name="model_id" ref="model_ea_firm_support_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
