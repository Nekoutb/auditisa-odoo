<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ea_firm_access_log_list" model="ir.ui.view">
        <field name="name">ea.firm.access.log.list</field>
        <field name="model">ea.firm.access.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="logged_at desc">
                <field name="logged_at"/>
                <field name="event"/>
                <field name="account"/>
                <field name="source"/>
            </list>
        </field>
    </record>
    <record id="action_ea_firm_access_log" model="ir.actions.act_window">
        <field name="name">Operator access to this server</field>
        <field name="res_model">ea.firm.access.log</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_ea_firm_access_log" name="Operator access"
              parent="base.menu_administration" action="action_ea_firm_access_log" sequence="90"
              groups="base.group_system"/>
</odoo>
