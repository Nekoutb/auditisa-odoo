<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_heartbeat" model="ir.cron">
        <field name="name">AuditISA: heartbeat to the platform</field>
        <field name="model_id" ref="model_ea_firm_agent"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_heartbeat()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_access_log" model="ir.cron">
        <field name="name">AuditISA: import the operator access log</field>
        <field name="model_id" ref="model_ea_firm_access_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_import()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
